{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moai:protocol:v1:profile",
  "title": "Profile (current, describes src/profile.rs Profile)",
  "description": "Describes the existing serde type; deny_unknown_fields maps to additionalProperties false. Value checks done in code (portability, secret shapes) are not restated here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "purpose", "tools", "development_methods", "hosts"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "project_id": {"type": "string"},
    "purpose": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "development_methods": {"type": "array", "items": {"type": "string"}},
    "hosts": {"type": "array", "items": {"enum": ["claude", "codex"]}},
    "package_pin": {"$ref": "urn:moai:protocol:v1:digest"},
    "interview_revision": {"type": "string"},
    "decisions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "value", "source", "scope"],
        "properties": {
          "id": {"type": "string"},
          "topic": {"type": "string"},
          "value": {"type": "string"},
          "source": {"enum": ["repo", "user", "default"]},
          "scope": {"type": "string"}
        }
      }
    },
    "language": {
      "description": "Writing language per item (#2293). Item ids and codes are the tables in src/language.rs.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "user_chat": {"$ref": "#/$defs/language_code"},
        "reports": {"$ref": "#/$defs/language_code"},
        "issue_pr_records": {"$ref": "#/$defs/language_code"},
        "commit_messages": {"$ref": "#/$defs/language_code"},
        "agent_messages": {"$ref": "#/$defs/language_code"},
        "instruction_files": {"$ref": "#/$defs/language_code"},
        "skill_instructions": {"$ref": "#/$defs/language_code"},
        "code_comments": {"$ref": "#/$defs/language_code"}
      }
    }
  },
  "$defs": {
    "language_code": {"enum": ["en", "ko", "ja", "zh"]}
  }
}
