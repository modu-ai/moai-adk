{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:moai:protocol:v1:profile",
  "title": "Profile (current, describes src/profile.rs Profile)",
  "description": "Describes the existing serde type; deny_unknown_fields maps to additionalProperties false. Value checks done in code (portability, secret shapes) are not restated here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "purpose", "tools", "development_methods", "hosts"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "project_id": {"type": "string"},
    "purpose": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "development_methods": {"type": "array", "items": {"type": "string"}},
    "hosts": {"type": "array", "items": {"enum": ["claude", "codex"]}},
    "package_pin": {"$ref": "urn:moai:protocol:v1:digest"},
    "interview_revision": {"type": "string"},
    "decisions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "value", "source", "scope"],
        "properties": {
          "id": {"type": "string"},
          "topic": {"type": "string"},
          "value": {"type": "string"},
          "source": {"enum": ["repo", "user", "default"]},
          "scope": {"type": "string"}
        }
      }
    },
    "detected": {
      "description": "Project facts from project-detect (#2496); lists are sorted and unique.",
      "type": "object",
      "additionalProperties": false,
      "required": ["project_kind", "manifests", "languages", "lsp", "mcp_servers", "databases"],
      "properties": {
        "project_kind": {"enum": ["new", "existing"]},
        "manifests": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "languages": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "lsp": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "mcp_servers": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
        "databases": {"type": "array", "maxItems": 64, "items": {"type": "string"}}
      }
    }
  }
}
