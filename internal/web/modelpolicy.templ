package web

// SPEC-WEB-CONSOLE-013 M3 — READ-ONLY Model Policy Templ component.
//
// modelPolicyPage renders the standalone Model Policy dashboard (GET
// /model-policy). It reuses the settings/board page chrome (foucHeadScript,
// @icon, @boardAppbar) but is a SEPARATE read-only page: it carries no form, no
// text input, and no dropdown control (the interface-language picker lives
// inside @boardAppbar, in board.templ — not this file), and no htmx post
// affordance. The routing profiles render as plain table markup
// (REQ-WC13-020/021). The legacy flat workflow.model_routing block and
// workflow.workflow_agents are never rendered (REQ-WC13-022/023).

templ modelPolicyPage(view modelPolicyView) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>MoAI Web Console — Model Policy</title>
			<link rel="stylesheet" href="/static/console.css"/>
			@templ.Raw(foucHeadScript)
		</head>
		<body>
			@boardAppbar(boardView{BindAddr: view.BindAddr})
			<main class="page">
				<div class="pagehead">
					<h1>Model <span class="accent" data-i18n="mp.title">Policy</span></h1>
					<p class="pagehead__sub" data-i18n="mp.subtitle">Read-only model routing policy (loopback only — local machine)</p>
				</div>
				if view.Banner != "" {
					@boardBanner(boardView{Banner: view.Banner})
				}
				<section class="board-section" aria-labelledby="mp-plan-h">
					<h2 id="mp-plan-h" data-i18n="mp.plan.title">Plan type</h2>
					<p class="board-section__desc" data-i18n="mp.plan.desc">llm.plan_type — the billing-context tier profile (api = API-metered, subscription = weekly quota). Switching re-applies the matching model/effort tier matrix to the shipped agents.</p>
					<p class="mp-plan-active">
						<span data-i18n="mp.plan.active">Active plan</span>: <code class="mp-plan-active-value">{ view.ActivePlanType }</code>
						if view.PlanTypeIsEmpty {
							<span class="mp-ro" data-i18n="mp.plan.default">(default: subscription — llm.plan_type unset)</span>
						}
					</p>
					<form class="mp-plan-form" method="post" action="/model-policy/plan-type">
						<label class="mp-plan-label" for="mp-plan-select" data-i18n="mp.plan.select">Switch plan type</label>
						<select id="mp-plan-select" name="plan_type">
							for _, opt := range modelPolicyPlanOptions() {
								<option value={ opt } selected?={ opt == view.ActivePlanType }>{ opt }</option>
							}
						</select>
						<button type="submit" data-i18n="mp.plan.apply">Apply</button>
					</form>
				</section>
				<section class="board-section" aria-labelledby="mp-tier-h">
					<h2 id="mp-tier-h" data-i18n="mp.tier.title">Performance tier</h2>
					<p class="board-section__desc" data-i18n="mp.tier.desc">llm.performance_tier — the model/effort tier column applied to the shipped agents (max / medium / low). Switching re-applies the matching tier profile to every shipped agent definition file.</p>
					<p class="mp-plan-active">
						<span data-i18n="mp.tier.active">Active tier</span>:
						<code class="mp-plan-active-value">
							if view.PerfTierIsEmpty {
								medium
							} else {
								{ view.PerfTier }
							}
						</code>
						if view.PerfTierIsEmpty {
							<span class="mp-ro" data-i18n="mp.tier.default">(runtime default: medium — llm.performance_tier unset)</span>
						}
					</p>
					<form class="mp-plan-form" method="post" action="/model-policy/tier">
						<label class="mp-plan-label" for="mp-tier-select" data-i18n="mp.tier.select">Switch performance tier</label>
						<select id="mp-tier-select" name="performance_tier">
							for _, opt := range modelPolicyPerfTiers() {
								<option value={ opt } selected?={ opt == view.PerfTier || (view.PerfTierIsEmpty && opt == "medium") }>{ opt }</option>
							}
						</select>
						<button type="submit" data-i18n="mp.tier.apply">Apply</button>
					</form>
				</section>
				<section class="board-section" aria-labelledby="mp-preview-h">
					<h2 id="mp-preview-h" data-i18n="mp.plan.preview.title">Per-tier model / effort preview</h2>
					<p class="board-section__desc" data-i18n="mp.plan.preview.desc">Both plans, all retained agents across the max / medium / low tiers. Values are derived from the Go tier-profile structure (single source).</p>
					for _, prev := range view.PlanPreviews {
						<div class="mp-plan-preview">
							<h3 class="mp-plan-preview__plan"><span data-i18n="mp.plan.preview.plan">Plan</span>: <code>{ prev.PlanType }</code>
								if prev.IsActive {
									<span class="mp-plan-badge" data-i18n="mp.plan.preview.activebadge">(active)</span>
								}
							</h3>
							<table class="mp-plan-table">
								<thead>
									<tr>
										<th data-i18n="mp.plan.col.agent">Agent</th>
										<th>max</th>
										<th>medium</th>
										<th>low</th>
									</tr>
								</thead>
								<tbody>
									for _, row := range prev.Rows {
										<tr class="mp-plan-row">
											<td><code>{ row.Agent }</code></td>
											for _, cell := range row.Cells {
												<td><code>{ cell.Model }</code><span class="mp-plan-sep"> / </span><code>{ cell.Effort }</code></td>
											}
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
				<section class="board-section" aria-labelledby="mp-tier-h">
					<h2 id="mp-tier-h" data-i18n="mp.tier.title">Active performance tier</h2>
					<p class="board-section__desc" data-i18n="mp.tier.desc">llm.performance_tier — the routing-profile selector (max/medium/low). Distinct from the Launch section's model_policy (init-time agent frontmatter policy, high/medium/low).</p>
					if view.PerfTierIsEmpty {
						<p class="mp-tier-value"><span class="mp-ro" data-i18n="mp.tier.empty">(runtime default: medium)</span></p>
					} else {
						<p class="mp-tier-value"><code class="mp-tier-code">{ view.PerfTier }</code></p>
					}
				</section>
				<section class="board-section" aria-labelledby="mp-table-h">
					<h2 id="mp-table-h" data-i18n="mp.table.title">Routing profiles (3 tiers × 12 cells)</h2>
					<p class="board-section__desc" data-i18n="mp.table.desc">workflow.model_routing_profiles — model and effort per (performance tier × SPEC tier × phase). Read-only.</p>
					if view.BlockAbsent {
						<p class="board-empty" data-i18n="mp.table.absent">model_routing_profiles is absent from workflow.yaml — every lookup falls back to inherit / medium (defaultRoutingEntry).</p>
					}
					for _, prof := range view.Profiles {
						<div class="mp-profile">
							<h3 class="mp-profile__tier"><span data-i18n="mp.profile.label">Performance tier</span>: <code>{ prof.PerfTier }</code></h3>
							<table class="mp-table">
								<thead>
									<tr>
										<th data-i18n="mp.col.tier">Tier</th>
										<th data-i18n="mp.col.phase">Phase</th>
										<th data-i18n="mp.col.model">Model</th>
										<th data-i18n="mp.col.effort">Effort</th>
									</tr>
								</thead>
								<tbody>
									for _, c := range prof.Cells {
										<tr>
											<td><code>{ c.Tier }</code></td>
											<td><code>{ c.Phase }</code></td>
											<td><code>{ c.Model }</code></td>
											<td>
												<code>{ c.Effort }</code>
												if c.Fallback {
													<span class="mp-fallback" data-i18n="mp.fallback">(fallback)</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					}
				</section>
			</main>
			<script src="/static/i18n.js"></script>
			<script src="/static/app.js"></script>
		</body>
	</html>
}
