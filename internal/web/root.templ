package web

// page 는 설정 화면의 Templ 루트다. 재설계 이전에는 자기 <html> 셸 · appbar ·
// 히어로 밴드 · 가로 탭 nav · 프로필 바 · 하단 저장 바를 직접 들고 있었다.
// 그 여섯 가지는 전부 재설계본 셸(shell.templ)로 올라갔다:
//
//   <html>/<head>   → Shell
//   appbar          → 좌측 레일 + 상단바
//   히어로 밴드      → 상단바의 제목 + 빵부스러기
//   가로 탭 nav      → 레일의 세로 subnav (`/settings?tab=<id>`)
//   프로필 바        → 레일 하단의 프로필 팝오버 (전환·생성·이름변경·삭제)
//   하단 저장 바     → 상단바의 저장 클러스터 (form="settings-form")
//
// 여기 남는 것은 폼과 패널뿐이다. 폼 계약(action · name 속성 · POST 라우트)은
// 하나도 바뀌지 않았다 — 옮긴 것은 크롬이지 제출 경로가 아니다.

// saveAction builds the form action target, appending ?profile=<selected> when a
// profile is selected (mirrors `/save{{if .SelectedProfile}}?profile=...{{end}}`).
func saveAction(selected string) string {
	if selected != "" {
		return "/save?profile=" + selected
	}
	return "/save"
}

// bannerClass maps the server-set BannerKind to the banner chrome class. The
// design system carries exactly one chromatic accent (danger), so an error
// banner is the only variant — a success banner reads as the neutral note.
func bannerClass(kind string) string {
	if kind == "error" {
		return "banner banner--warn"
	}
	return "banner"
}

templ page(vm ShellVM, view pageView) {
	@Shell(vm) {
		if view.Banner != "" {
			@banner(view)
		}
		@settingsPageHeader(vm, view)
		// HTMX foundation (REQ-WC6-015): hx-boost is progressive enhancement
		// only — with htmx loaded the submit becomes an AJAX full-page swap, and
		// with JS/htmx disabled the form degrades to the existing full-page POST
		// round-trip. The server response shape is the SAME full HTML page in both
		// cases (REQ-WC6-014).
		//
		// id="settings-form" 은 상단바 저장 버튼의 form= 대상이다. 버튼이 폼 밖에
		// 있어도 같은 폼을 제출한다 — 저장은 스크롤 위치와 무관하게 늘 손 닿는 곳에
		// 있어야 하기 때문이다.
		<form
			id="settings-form"
			class="form"
			method="POST"
			action={ templ.SafeURL(saveAction(view.SelectedProfile)) }
			hx-boost="true"
		>
			<input type="hidden" name="__profile" value={ view.SelectedProfile }/>
			// 저장 후 보고 있던 탭으로 돌아온다. 활성 탭은 서버가 고르므로
			// 제출에 실어 보내지 않으면 저장할 때마다 첫 탭으로 튕긴다.
			<input type="hidden" name="__tab" value={ vm.Tab }/>
			// 패널은 consoleTabs() 순서 그대로, 전부 DOM 에 남는다. 활성 패널만
			// 보이지만 비활성 패널의 필드도 함께 제출된다 — 렌더에서 빼면
			// 미제출 = 값 보존으로 읽혀 atomic Save 계약이 조용히 깨진다.
			for _, tab := range consoleTabs() {
				<div
					class={ "tabpanel", templ.KV("is-active", tab.ID == vm.Tab) }
					data-panel={ tab.ID }
					id={ "panel-" + tab.ID }
					role="tabpanel"
					aria-labelledby={ "tab-" + tab.ID }
				>
					switch tab.ID {
						case "identity":
							@fieldsetIdentity(view)
						case "language":
							@fieldsetLanguage(view)
						case "launch":
							@fieldsetLaunch(view)
						case "agentfm":
							@fieldsetAgentFrontmatter(view)
						case "mcp":
							@fieldsetMCP(view)
						case "codex":
							// SPEC-WEB-CODEX-PANEL-001: the read-only codex
							// mirror. It cannot go through the generic
							// fieldsetSchemaSection default branch — that
							// branch renders inputs, and a second control for
							// an already-rendered field loses the user's edit
							// silently (one form, PostFormValue reads the
							// first value only).
							@fieldsetCodex(view)
						default:
							@fieldsetSchemaSection(view, schemaPanelMeta(tab.ID))
					}
				</div>
			}
		</form>
	}
}

// settingsPageHeader makes the active setting legible before a user reaches
// the field rows: what this page owns, when its values take effect, and how
// many sibling pages remain available in the 14-page contract.
templ settingsPageHeader(vm ShellVM, view pageView) {
	<section class="settings-page-head" aria-labelledby="settings-page-title">
		<div class="settings-page-head__copy">
			<span class="eyebrow" data-i18n="settings.detail.eyebrow">Settings detail</span>
			<h2 id="settings-page-title" class="settings-page-head__title" data-i18n={ activeSettingsTabLabelKey(vm) }>{ activeSettingsTabLabel(vm) }</h2>
			<p class="settings-page-head__desc" data-i18n={ activeSettingsTabDescKey(vm) }>{ activeSettingsTabDesc(vm) }</p>
		</div>
		<div class="settings-page-head__meta">
			<span><span data-i18n="settings.detail.profile">Profile</span> <code class="mono">{ view.SelectedProfile }</code></span>
			<span><span data-i18n="settings.detail.pages">Pages</span> <code class="mono">{ itoa(len(vm.Tabs)) }</code><span data-i18n="settings.detail.pages.suffix"> total</span></span>
			<span class="badge badge--outline" data-i18n={ activeSettingsTabEffectKey(vm) }>{ activeSettingsTabEffect(vm) }</span>
			<a class="settings-page-head__link" href={ templ.SafeURL("/settings?tab=" + vm.Tab) }>
				<span data-i18n="settings.detail.direct">Open direct link</span>
				@iconAt("external", 13)
			</a>
		</div>
	</section>
}

// profileModifiable reports whether the create/rename/delete controls may act
// on a profile. The default profile, the profile currently active per
// GetCurrentName, and the profile the console is editing are all off limits —
// mirroring the server-side guards in handleProfileDelete and
// handleProfileRename. The server enforces the block regardless; not offering
// the control keeps the UI from proposing an action it will refuse.
func profileModifiable(view pageView, name string, current bool) bool {
	return name != "default" && !current && name != view.SelectedProfile
}

// profileDeleteAction is the delete form target.
func profileDeleteAction() string { return "/profile/delete" }

// profileCreateAction is the create form target.
func profileCreateAction() string { return "/profile/create" }

// profileRenameAction is the rename form target.
func profileRenameAction() string { return "/profile/rename" }

// banner ports the server-rendered status block into the §5 banner vocabulary.
templ banner(view pageView) {
	<div class={ bannerClass(view.BannerKind) } role="status" aria-live="polite">
		if view.BannerKind == "error" {
			@iconAt("alert", 14)
		} else {
			@iconAt("check", 14)
		}
		<span>{ view.Banner }</span>
	</div>
}
