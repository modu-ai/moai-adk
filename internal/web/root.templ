package web

import "github.com/modu-ai/moai-adk/internal/profile"

// page is the Templ root component for the Console (SPEC-WEB-CONSOLE-006). It
// ports the <html> shell + FOUC <head> script + appbar + 5 fieldsets + actions
// from the retired page.html.tmpl 1:1, preserving the exact markup contract so
// the characterization gate stays green (spec.md §2). The view-model pageView is
// the typed input; handlers.go:render() renders this into a buffer first (the
// REQ-WC6-018 error discipline).

// foucHeadScript is the FOUC-prevention <head> snippet (page.html.tmpl ~8-28),
// emitted as a complete <script>...</script> element via templ.Raw. It applies
// the persisted interface language before first paint. It is a fixed
// compile-time constant — no user data flows into it — so emitting it via
// templ.Raw carries no injection surface (REQ-WC6-017).
//
// SPEC-DESIGN-MOAIWEBV2-002 (REQ-MWA-003): the former theme branch
// (persisted theme read -> <html> attribute set) is retired with the dark
// theme — the console is light-only. ONLY the language branch below survives,
// verbatim (REQ-WC5-005 CJK font-activation lineage, AC-MWA-003b).
//
// The whole <script> element (tags + body) is rendered via templ.Raw at the head
// level rather than placing @templ.Raw INSIDE a <script> element, because Templ
// treats the contents of a <script> element as literal (un-evaluated) script text
// — a nested @templ.Raw there would render the directive literally.
const foucHeadScript = `<script>
    // FOUC-prevention: apply the persisted interface language before first
    // paint (REQ-WC5-005). Client-side only — no server round-trip, no
    // language persistence field. Setting <html lang> early activates the CJK
    // @font-face stack for ja/zh before paint so the first render already
    // uses the brand webfont (no system-ui flash).
    (function () {
      try {
        var l = localStorage.getItem("moai-console-lang");
        if (l === "en" || l === "ko" || l === "ja" || l === "zh") {
          document.documentElement.setAttribute("lang", l);
        }
      } catch (e) { /* localStorage unavailable — keep the default en interface */ }
    })();
  </script>`

// The header brand badge is the mascot image (mascot-thinking.png) served from /static/mascots/.

// saveAction builds the form action target, appending ?profile=<selected> when a
// profile is selected (mirrors `/save{{if .SelectedProfile}}?profile=...{{end}}`).
func saveAction(selected string) string {
	if selected != "" {
		return "/save?profile=" + selected
	}
	return "/save"
}

// bannerClass maps the server-set BannerKind to the success/error chrome class
// (page.html.tmpl ~97). "error" -> banner--error; anything else -> banner--success.
func bannerClass(kind string) string {
	if kind == "error" {
		return "banner banner--error"
	}
	return "banner banner--success"
}

templ page(view pageView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>MoAI Web Console</title>
			<link rel="stylesheet" href="/static/console.css"/>
			@templ.Raw(foucHeadScript)
		</head>
		<body>
			@appbar(view)
			<main class="page">
				// SPEC-DESIGN-MOAIWEBV2-002 M1: compact hero band — text left, mascot
				// right (docs-site v2 .doc-hero--compact direction). Decorative image
				// (alt="") — the adjacent h1 carries the page identity.
				<div class="pagehead">
					<div class="pagehead__text">
						<h1>MoAI <span class="accent">Web Console</span></h1>
						<p class="pagehead__sub" data-i18n="app.subtitle">Edit profile preferences &amp; project settings (loopback only — local machine)</p>
					</div>
					<img class="pagehead__mascot" src="/static/mascots/mascot-explaining.png" alt="" width="110" height="110"/>
				</div>
				// SPEC-WEB-CONSOLE-REDESIGN-001 M5: one profile surface, not two.
				// The bar carries the switch select AND the create / rename / delete
				// controls. It is rendered OUTSIDE the main settings form because
				// each control is its own POST target and a nested <form> is invalid
				// HTML that browsers silently drop (REQ-WCR-041). Always rendered so
				// the first non-default profile can be created.
				@profileBar(view)
				if view.Banner != "" {
					@banner(view)
				}
				// HTMX foundation (REQ-WC6-015): hx-boost is progressive enhancement
				// only — with htmx loaded the submit becomes an AJAX full-page swap, and
				// with JS/htmx disabled the form degrades to the existing full-page POST
				// round-trip. The server response shape is the SAME full HTML page in both
				// cases (REQ-WC6-014). NO section-scoped partial-swap attribute and NO
				// /save fragment response are introduced here — those are deferred to
				// SPEC-WEB-CONSOLE-007 (E.3). (This is a Templ Go-comment, NOT an HTML
				// comment, so it is not emitted into the rendered page.)
				<form class="form" method="POST" action={ templ.SafeURL(saveAction(view.SelectedProfile)) } hx-boost="true">
					<input type="hidden" name="__profile" value={ view.SelectedProfile }/>
					// SPEC-WEB-CONSOLE-REDESIGN-001 M6: the /autonomy/tiers toggle link is
					// removed. It was a GET-only fragment with no form and no action, so no
					// selection it offered could be persisted (see autonomy_console_test.go).
					// M5-b D1: 탭 nav. 각 탭 label 은 기존 sec.<section>.title i18n 키를
					// 재사용한다 (0 NEW sec.* keys). 탭은 type="button" 이라 폼을 제출하지
					// 않는다. 모든 패널이 DOM 에 상주한다 (atomic Save contract).
					<nav class="tabs" role="tablist">
						for i, tab := range consoleTabs() {
							if i == 0 {
								<button class="tab is-active" type="button" role="tab" data-tab={ tab.ID } aria-selected="true">
									<span data-i18n={ tab.LabelKey }>{ tab.Baseline }</span>
								</button>
							} else {
								<button class="tab" type="button" role="tab" data-tab={ tab.ID } aria-selected="false">
									<span data-i18n={ tab.LabelKey }>{ tab.Baseline }</span>
								</button>
							}
						}
					</nav>
					// M5-b D1: 각 fieldset 을 .tabpanel 로 감싼다. CSS 가 비활성 패널을
					// display:none 한다 — DOM 에서 제거하지 않으므로 비활성 패널의
					// 필드도 제출된다 (atomic Save contract).
					//
					// SPEC-WEB-CONSOLE-REDESIGN-001 M2: 패널은 consoleTabs() 순서를
					// 그대로 따라 생성된다 — 탭 목록이 순서의 단일 원천이고, 패널 ID 가
					// 섹션 ID 와 같다는 전제(한 패널 = 한 섹션)는 깨졌다. 수제 fieldset
					// 3종과 agentfm 은 명시 분기로, 나머지는 스키마 주도 제네릭 패널로
					// 렌더한다.
					for i, tab := range consoleTabs() {
						<div class={ "tabpanel", templ.KV("is-active", i == 0) } data-panel={ tab.ID }>
							switch tab.ID {
								case "identity":
									@fieldsetIdentity(view)
								case "language":
									@fieldsetLanguage(view)
								case "launch":
									@fieldsetLaunch(view)
								case "agentfm":
									@fieldsetAgentFrontmatter(view)
								default:
									@fieldsetSchemaSection(view, schemaPanelMeta(tab.ID))
							}
						</div>
					}
					<div class="actions">
						<button class="btn btn--primary" type="submit">@icon("save")<span data-i18n="actions.save">Save settings</span></button>
						<span class="actions__meta" data-i18n="actions.meta">writes to ~/.moai profile &amp; project config</span>
					</div>
				</form>
			</main>
			<script src="/static/i18n.js"></script>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/app.js"></script>
		</body>
	</html>
}

// appbar ports the brand strip (page.html.tmpl ~33-70): brand badge SVG +
// 모두의AI + loopback{ view.BindAddr } + langpick(uiLangSelect, NO name=, OUTSIDE
// form). (The former theme toggle is retired — SPEC-DESIGN-MOAIWEBV2-002
// REQ-MWA-002, light-only console.)
templ appbar(view pageView) {
	<header class="appbar">
		<span class="brand" aria-label="MoAI-ADK">
			<span class="brand__badge">
				<img class="brand__mascot" src="/static/mascots/mascot-thinking.png" alt="MoAI-ADK" width="28" height="28"/>
			</span>
			<span class="brand__name">MoAI-ADK</span>
		</span>
		<span class="appbar__divider"></span>
		<span class="loopback"><span class="loopback__dot"></span>{ view.BindAddr }</span>
		<span class="appbar__badge" title={ view.ProjectPath }>
			📁{ view.ProjectName }
		</span>
		<span class="appbar__badge">
			👤{ view.SelectedProfile }
		</span>
		<div class="appbar__context">
			<span class="appbar__context-text">lang: ko · model: claude-opus-5 · effort: high · dev: ddd</span>
		</div>
		<span class="appbar__spacer"></span>
		<span class="select-wrap langpick-wrap">
			<select class="select langpick" id="uiLangSelect" aria-label="Interface language" title="Interface language">
				<option value="en">English</option>
				<option value="ko">한국어</option>
				<option value="ja">日本語</option>
				<option value="zh">中文</option>
			</select>
		</span>
		<button class="iconbtn" id="serverShutdown" type="button"
			aria-label="Shut down server" title="Shut down server">
				@icon("power")
			</button>
		</header>
	}

// profileModifiable reports whether the create/rename/delete controls may act
// on a profile. The default profile, the profile currently active per
// GetCurrentName, and the profile the console is editing are all off limits —
// mirroring the server-side guards in handleProfileDelete and
// handleProfileRename. The server enforces the block regardless; not offering
// the control keeps the UI from proposing an action it will refuse.
func profileModifiable(view pageView, name string, current bool) bool {
	return name != "default" && !current && name != view.SelectedProfile
}

// modifiableProfiles returns the profiles the CRUD controls may target.
func modifiableProfiles(view pageView) []profile.ProfileEntry {
	var out []profile.ProfileEntry
	for _, p := range view.Profiles {
		if profileModifiable(view, p.Name, p.Current) {
			out = append(out, p)
		}
	}
	return out
}

// profileDeleteAction is the delete form target.
func profileDeleteAction() string { return "/profile/delete" }

// profileCreateAction is the create form target.
func profileCreateAction() string { return "/profile/create" }

// profileRenameAction is the rename form target.
func profileRenameAction() string { return "/profile/rename" }

// profileBar is the single profile surface (SPEC-WEB-CONSOLE-REDESIGN-001 M5,
// REQ-WCR-040/041/042). It replaces the former profileSwitch + profileManager
// pair: the switch select and the create / rename / delete controls now sit
// together, and the separate card is gone.
//
// Each CRUD control is its own <form> with its own POST action. They sit here,
// outside the main settings <form>, because nesting a form inside a form is
// invalid HTML — a browser drops the inner start tag and the control silently
// stops working. hx-boost turns the POSTs into AJAX full-page swaps where htmx
// is available and degrades to plain round-trips where it is not; either way the
// server returns the full page, the same contract as /save.
//
// Rename and delete target a profile chosen from a select listing only the
// eligible ones. When nothing is eligible those controls are not rendered at
// all, rather than offering an empty select.
templ profileBar(view pageView) {
	<div class="profilebar" hx-boost="true">
		// REQ-WC-011 is preserved verbatim across the M5 consolidation: the
		// switch select is omitted when `default` is the only profile, because
		// there is nothing to switch between. The create form below is NOT
		// gated on it — without that, a user with only `default` would have no
		// way to make a second profile.
		if view.ShowProfileSwitch {
			<div class="profilebar__row">
				<label class="profilebar__label" for="__profile_select" data-i18n="profile.label">Profile:</label>
				<span class="select-wrap">
					<select class="select" name="__profile_select" id="__profile_select" aria-label="Active profile">
						for _, p := range view.Profiles {
							if p.Name == view.SelectedProfile {
								if p.Current {
									<option value={ p.Name } selected>{ p.Name } (current)</option>
								} else {
									<option value={ p.Name } selected>{ p.Name }</option>
								}
							} else {
								if p.Current {
									<option value={ p.Name }>{ p.Name } (current)</option>
								} else {
									<option value={ p.Name }>{ p.Name }</option>
								}
							}
						}
					</select>
				</span>
				<span class="profilebar__meta">selected: <strong>{ view.SelectedProfile }</strong></span>
			</div>
		}
		<div class="profilebar__actions">
			<form class="profilebar__form" method="POST" action={ templ.SafeURL(profileCreateAction()) }>
				<label class="profilebar__form-label" for="profile_name_new" data-i18n="profile.create.label">New profile name</label>
				<input class="input input--sm" type="text" id="profile_name_new" name="profile_name" placeholder="e.g. work" autocomplete="off"/>
				<button class="btn btn--primary btn--sm" type="submit" data-i18n="profile.create.button">Create</button>
			</form>
			if len(modifiableProfiles(view)) > 0 {
				<form class="profilebar__form" method="POST" action={ templ.SafeURL(profileRenameAction()) }>
					<label class="profilebar__form-label" for="profile_rename_target" data-i18n="profile.rename.label">Rename profile</label>
					<span class="select-wrap">
						<select class="select select--sm" id="profile_rename_target" name="profile_name" aria-label="Profile to rename">
							for _, p := range modifiableProfiles(view) {
								<option value={ p.Name }>{ p.Name }</option>
							}
						</select>
					</span>
					<input class="input input--sm" type="text" id="profile_rename_new" name="new_name" placeholder="new name" autocomplete="off" aria-label="New profile name"/>
					<button class="btn btn--ghost btn--sm" type="submit" data-i18n="profile.rename.button">Rename</button>
				</form>
				<form class="profilebar__form" method="POST" action={ templ.SafeURL(profileDeleteAction()) }>
					<label class="profilebar__form-label" for="profile_delete_target" data-i18n="profile.delete.label">Delete profile</label>
					<span class="select-wrap">
						<select class="select select--sm" id="profile_delete_target" name="profile_name" aria-label="Profile to delete">
							for _, p := range modifiableProfiles(view) {
								<option value={ p.Name }>{ p.Name }</option>
							}
						</select>
					</span>
					<button class="btn btn--ghost btn--sm" type="submit" data-i18n="profile.delete.button">Delete</button>
				</form>
			}
		</div>
	</div>
}

// banner ports the {{if .Banner}} server-rendered status block (page.html.tmpl ~96-103).
templ banner(view pageView) {
	<div class={ bannerClass(view.BannerKind) } role="status" aria-live="polite">
		<span class="banner__icon">
			if view.BannerKind == "error" {
				@icon("alert-circle")
			} else {
				@icon("check-circle")
			}
		</span>
		<div class="banner__body">
			<p class="banner__text">{ view.Banner }</p>
		</div>
	</div>
}
