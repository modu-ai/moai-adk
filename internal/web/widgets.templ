// 재설계본 표시 위젯 — §5.5 어휘(생존 · 백엔드 · 단계 · 게이지 · 추정)와
// 패널/배너/배지.
//
// handoff 원본 대비 로컬 보정:
//   1) `banner` → `noteBanner` 로 개명했다. root.templ 이 이미 `banner(view
//      pageView)` 를 정의하고 있어 이름이 충돌한다.
//   2) 원본의 폼 위젯(field/textInput/selectInput/toggleInput/segInput)은
//      가져오지 않았다. 설정 화면의 폼 마크업은 page.templ + fieldsets.templ
//      이 소유하고, 그 안에 `name` 속성과 저장 키가 들어 있다 (C5). 시그니처가
//      다른 위젯을 나란히 두면 어느 쪽이 실제 렌더인지 알 수 없어진다.
//   3) 아이콘은 `iconAt(name, size)` 를 쓴다 — 기존 `icon(name)` 1-arg 호출부
//      39곳을 건드리지 않기 위해서다.
package web

// panel 은 화면 구획 하나. density 는 roomy | dense 로 필드 밀도를 정한다.
// metaKey 는 meta 가 개수를 포함한 합성문("registry 5")일 때의 번역 키다 —
// metaParams 가 {0} 자리에 숫자를 넣는다. 비어 있으면 meta 를 그대로 렌더한다.
templ panel(title, meta, metaKey, metaParams, help, density string) {
	<section class="panel" data-density={ density }>
		<div class="panel__head">
			<h2 class="panel__title" data-i18n={ "panel." + i18nSlug(title) }>{ title }</h2>
			if meta != "" {
				if metaKey != "" {
					<span class="panel__meta" data-i18n={ metaKey } data-i18n-params={ metaParams }>{ meta }</span>
				} else {
					<span class="panel__meta">{ meta }</span>
				}
			}
		</div>
		if help != "" {
			<p class="panel__help" data-i18n={ "panelHelp." + i18nSlug(title) }>{ help }</p>
		}
		{ children... }
	</section>
}

// noteBanner 는 화면 안내문. kind == "warn" 이면 주의 배너가 된다.
// key 는 text 의 번역 키다 — 비어 있으면 text 를 그대로 렌더한다(번역 안 된
// 안내문과 번역된 안내문이 같은 위젯에서 나올 수 있어 선택적으로 둔다).
templ noteBanner(kind, text, key string) {
	<p class={ "banner", templ.KV("banner--warn", kind == "warn") } role={ bannerRole(kind) }>
		if kind == "warn" {
			@iconAt("alert", 14)
		} else {
			@iconAt("note", 14)
		}
		if key != "" {
			<span data-i18n={ key }>{ text }</span>
		} else {
			<span>{ text }</span>
		}
	</p>
}

/* ── §5.5 어휘 위젯 ─────────────────────────────────────
   확정 / 추정 / 기록 없음을 모양으로 가른다.
   state: live(PID 확인됨) | stale(하트비트 낡음) | idle(미기동)
   ------------------------------------------------------ */

templ stateMark(state string, label string) {
	<span class={ "state", "state--" + state }>
		<span class="state__dot" aria-hidden="true"></span>
		if label != "" {
			<span data-i18n={ "state." + state }>{ label }</span>
		}
	</span>
}

templ backendBadge(backend string) {
	if backend == "" {
		@missing()
	} else {
		<span class={ "backend", templ.KV("backend--metered", backend == "glm") }>
			<b>{ backend }</b>
			if backend == "glm" {
				<span data-i18n="backend.metered">metered</span>
			} else {
				<span data-i18n="backend.flat">flat rate</span>
			}
		</span>
	}
}

// stageMark — 추정일 때는 est 로 감싼다. 단정하지 않는다.
templ stageMark(stage string, estimated bool) {
	if estimated {
		<span class="est" title="estimated from last_heartbeat — no transition record exists">
			@stageInner(stage)
			<span class="est__tag" data-i18n="mark.estimated">estimate</span>
		</span>
	} else {
		@stageInner(stage)
	}
}

templ stageInner(stage string) {
	<span class={ "stage", "stage--" + stage }>
		<span class="stage__g" aria-hidden="true">{ stageGlyph(stage) }</span>
		<span data-i18n={ "stage." + stage }>{ stageLabel(stage) }</span>
	</span>
}

// gauge — pct < 0 은 "기록 없음"이다. 0% 로 그리지 않는다.
templ gauge(label string, pct int) {
	if pct < 0 {
		<span class="gauge">
			<span class="gauge__l">{ label }</span>
			@missing()
		</span>
	} else {
		<span class="gauge">
			<span class="gauge__l">{ label }</span>
			<span class="gauge__t" role="meter" aria-valuenow={ itoa(pct) } aria-valuemin="0" aria-valuemax="100">
				<span style={ "width:" + itoa(pct) + "%" }></span>
			</span>
			<span class="gauge__v">{ itoa(pct) + "%" }</span>
		</span>
	}
}

// missing — 그럴듯한 값을 채우지 않는다. 왜 없는지는 title 에 남긴다.
//
// title 은 "기록이 없다"는 사실만 말한다. 어떤 생산자가 이 값을 써야 한다는
// 주장은 하지 않는다 — 종전 문구가 지목하던 생산자는 실제 생산자가 아니었다.
// data-i18n-title 이 있어 이 안내도 나머지 화면과 같은 언어로 나온다.
templ missing() {
	<span class="missing" title="not recorded — this session has no record carrying this value yet" data-i18n-title="mark.notRecorded" aria-label="not recorded">—</span>
}

// laneUnresolved — 레인 하나를 세션에 붙일 수 없을 때의 표시. 이유를 함께
// 적는다: 세션이 없어서인지, 프로세스 식별자가 한 세션을 가리키지 못해서인지,
// 세션은 찾았으나 기록이 없어서인지는 읽는 사람에게 서로 다른 사실이다.
//
// 완결된 오답이 빈칸보다 나쁘기 때문에 존재하는 표시다 — 붙일 수 없으면
// 다른 레인의 기록을 그리는 대신 붙일 수 없다고 말한다.
templ laneUnresolved(reason string) {
	<span class="warn lane-unresolved" data-lane-unresolved={ reason }>
		@iconAt("alert", 13)
		<span data-i18n="kanban.laneUnresolved">Unresolved — no record can be attributed to this lane</span>
		<span class="panel__meta" data-i18n={ "kanban.laneUnresolved." + reason }>{ reason }</span>
	</span>
}

templ badge(kind, text string) {
	<span class={ "badge", templ.KV("badge--danger", kind == "danger"), templ.KV("badge--outline", kind == "outline"), templ.KV("badge--strong", kind == "strong") }>{ text }</span>
}

templ spark(history []bool) {
	<span class="spark" aria-hidden="true">
		for _, ok := range history {
			<span class={ "spark__b", templ.KV("spark__b--on", ok) }></span>
		}
	</span>
}
