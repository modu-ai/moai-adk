// 개요(/) · 칸반(/kanban) · SPEC(/specs) · 모니터(/monitor)
// 전부 읽기 전용. 실시간 갱신은 [data-live] 조각 단위로 htmx 가 다시 가져온다.
//
// handoff 원본 대비 로컬 보정: `@icon(name, size)` → `@iconAt(...)`,
// `@banner(...)` → `@noteBanner(...)` (이름 충돌 회피 — widgets.templ 주석 참조).
package web

/* ── 개요 ───────────────────────────────────────────── */

templ Overview(vm ShellVM, o OverviewVM) {
	@Shell(vm) {
		<div class="stats" data-live="spec">
			for _, s := range o.Stats {
				<div class="stat">
					<span class="stat__l" data-i18n={ "stat." + i18nSlug(s.Label) }>{ s.Label }</span>
					<span class="stat__v">{ s.Value }</span>
					// Note 이 개수를 품은 합성문("4 in-progress")이어도 키는 평평하게
					// 하나다 — {0} 자리에 NoteParams 의 숫자가 들어가므로 개수가
					// 바뀌어도 사전은 그대로다.
					<span class="stat__n" data-i18n={ s.NoteKey } data-i18n-params={ s.NoteParams }>{ s.Note }</span>
				</div>
			}
		</div>
		if o.Chain.Present {
			<section class="chainbar" data-live="kanban">
				<div class="chainbar__h">
					<span class="panel__meta" data-i18n="chain.title">Kanban chain</span>
					if o.Chain.CardID != "" {
						<span class="mono">{ o.Chain.CardID }</span>
					}
					if o.Chain.IdleRole != "" {
						<span class="warn">
							@iconAt("alert", 13)
							<span>{ o.Chain.IdleRole }</span>
							<span data-i18n="chain.stopped">— the chain stops here</span>
						</span>
					}
					<a class="panel__meta" href="/kanban" style="margin-left:auto">
						<span data-i18n="chain.open">Open in Kanban</span>
						@iconAt("chevron", 13)
					</a>
				</div>
				<ol class="chainbar__l">
					for _, r := range o.Chain.Roles {
						<li class={ "cpill", templ.KV("cpill--idle", r.State == "idle") }>
							<span class="cpill__r">{ r.Role }</span>
							@stateMark(r.State, stateLabel(r.State))
						</li>
					}
				</ol>
			</section>
		}
		<div class="two">
			<div class="col">
				@panel("In-progress SPECs", itoa(len(o.InProgress)), "", "", "", "roomy") {
					<div class="rows" data-live="spec">
						for _, s := range o.InProgress {
							@specRowLink(s)
						}
					</div>
				}
				@panel("Needs attention", itoa(len(o.Attention)), "", "", "MUST-FIX drift · failed verification · stalled goals · idle roles only.", "roomy") {
					<div class="rows">
						for _, a := range o.Attention {
							<a class="row-link" href={ templ.SafeURL(a.Href) }>
								@iconAt(a.Icon, 14)
								<span class="mono" style="flex:0 0 190px">{ a.Source }</span>
								// 칸반 미기동 행은 체인 띠와 같은 안내다 — 키를 공유해야
								// 한쪽만 번역되는 일이 없다. Role 이 비어 있는 일반 행은
								// 서버가 준 Text 를 그대로 둔다.
								if a.Role != "" {
									<span style="flex:1 1 auto;min-width:0">
										{ a.Role + " " }
										<span data-i18n="chain.sessionNotStarted">session not started</span>
										{" "}
										<span data-i18n="chain.stopped">— the chain stops here</span>
									</span>
								} else {
									<span style="flex:1 1 auto;min-width:0">{ a.Text }</span>
								}
								@badge(a.BadgeKind, a.Badge)
							</a>
						}
					</div>
				}
			</div>
			<aside class="rail2">
				@panel("Sessions", "registry "+itoa(len(o.Sessions)), "panelMeta.registry", itoa(len(o.Sessions)), "", "roomy") {
					@noteBanner("info", "The registry can hold entries whose process has exited. Only PID-confirmed sessions are marked active.", "banner.registry")
					<div class="rows" data-live="session">
						for _, s := range o.Sessions {
							<div class="sess">
								<span class="mono" style="display:flex;align-items:center;gap:7px">
									@stateMark(s.State, "")
									{ s.ID }
								</span>
								<span class="panel__meta" style="display:flex;align-items:center;gap:6px">
									@backendBadge(s.Backend)
									{ " · " + s.Heartbeat }
								</span>
							</div>
						}
					</div>
				}
			</aside>
		</div>
	}
}

templ specRowLink(s SpecRowVM) {
	<a class="row-link" href={ templ.SafeURL("/specs?id=" + s.ID) }>
		<span class="mono" style="flex:0 0 210px;font-size:11.5px">{ s.ID }</span>
		<span style="flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{ s.Title }</span>
		if s.Drift != "" {
			@badge("danger", s.Drift)
		}
		if s.Tier != "" {
			@badge("outline", s.Tier)
		}
		<span class="panel__meta" style="flex:0 0 82px;text-align:right">{ s.Updated }</span>
	</a>
}

/* ── 칸반 ───────────────────────────────────────────────
   뷰 A(체인 세션 보드)가 주, 뷰 B(SPEC 파이프라인 4컬럼)가 보조.
   뷰 A의 모델·effort·CW는 기록이 없으면 채우지 않고 비운다.
   ---------------------------------------------------- */

templ Kanban(vm ShellVM, k KanbanVM) {
	@Shell(vm) {
		<section data-live="kanban">
			<div class="panel__head" style="border-bottom-color:var(--line)">
				<h2 class="panel__title" data-i18n="kanban.viewA">Chain session board</h2>
				<span class="panel__meta" data-i18n="kanban.card">Current card</span>
				<span class="mono">{ k.CardID }</span>
				if k.IdleRole != "" {
					<span class="warn" style="margin-left:auto">
						@iconAt("alert", 13)
						<span>{ k.IdleRole }</span>
						<span data-i18n="chain.stopped">— the chain stops here</span>
					</span>
				}
			</div>
			<div class="roles">
				for i, r := range k.Roles {
					<article class={ "role", templ.KV("role--idle", r.State == "idle") }>
						<header class="role__h">
							<span class="role__n">
								<span class="mono panel__meta">{ itoa(i) }</span>
								{ r.Role }
							</span>
							@stageMark(r.Stage, r.StageEstimated)
						</header>
						<div class="role__b">
							@stateMark(r.State, stateLabel(r.State))
							if r.Session != "" {
								<span class="role__s">{ r.Session }</span>
							} else {
								<span class="role__s warn" data-i18n="kanban.noSession">No session</span>
							}
							<div class="role__kv">
								<span data-i18n="kanban.backend">Backend</span>
								@backendBadge(r.Backend)
								<span data-i18n="kanban.model">Model</span>
								if r.Model != "" {
									<span class="mono">{ r.Model }</span>
								} else {
									@missing()
								}
								<span>effort</span>
								if r.Effort != "" {
									<span class="mono">{ r.Effort }</span>
								} else {
									@missing()
								}
							</div>
							@gauge("CW", r.ContextPct)
							<span class="role__f">
								if r.Heartbeat != "" {
									{ r.Heartbeat }
								} else {
									<span class="warn" data-i18n="kanban.noStart">No start record</span>
								}
							</span>
						</div>
					</article>
					if i < len(k.Roles)-1 {
						<span class="arrow" aria-hidden="true">→</span>
					}
				}
			</div>
			@noteBanner("info", "Stage is estimated from heartbeat. Model, effort and context usage are not recorded yet, so they are left blank — they fill in once kanban.Record is extended.", "")
		</section>
		<section data-live="spec">
			<div class="panel__head" style="border-bottom-color:var(--line)">
				<h2 class="panel__title" data-i18n="kanban.viewB">SPEC pipeline</h2>
				<span class="panel__meta">{ "4 status columns · " + itoa(k.Total) }</span>
				<span class="panel__meta" style="margin-left:auto" data-i18n="kanban.terminal">superseded · archived · rejected via filter only</span>
			</div>
			<div class="board">
				for _, c := range k.Columns {
					<section class="kcol">
						<header class="kcol__h">
							<span class="kcol__n">{ c.ID }</span>
							<span class="count">{ itoa(len(c.Cards)) }</span>
							<span class="kcol__s">{ "status: " + c.Status }</span>
						</header>
						<div class="kcol__b">
							for _, s := range c.Cards {
								<a class="kcard" href={ templ.SafeURL("/specs?id=" + s.ID) }>
									<span class="kcard__id">{ s.ID }</span>
									<span class="kcard__t">{ s.Title }</span>
									<span class="kcard__f">
										if s.Tier != "" {
											@badge("outline", s.Tier)
										}
										if s.Drift != "" {
											@badge("danger", s.Drift)
										}
										<span class="panel__meta" style="margin-left:auto">{ s.Updated }</span>
									</span>
								</a>
							}
						</div>
					</section>
				}
			</div>
		</section>
	}
}

/* ── 백로그 큐(todo) ───────────────────────────────────── */

// Todo 는 백로그 큐를 읽기 전용으로 보여주는 화면이다. 섹션은 새 이벤트 이름을
// 만들지 않고 기존 data-live="kanban" 마커를 단다 — 큐 파일이
// .moai/state/kanban/backlog.json 이라 이미 watchMap["kanban"] 이 보는
// 디렉터리 안에 있고, 클라이언트의 refresh() 는 라우트가 아니라 이 마커를 보고
// 갱신하기 때문이다(REQ-WTQ-007).
templ Todo(vm ShellVM, q TodoVM) {
	@Shell(vm) {
		<section data-live="kanban">
			<div class="panel__head" style="border-bottom-color:var(--line)">
				<h2 class="panel__title" data-i18n="todo.title">Backlog queue</h2>
				<span class="panel__meta" data-i18n="todo.count">Cards</span>
				<span class="mono">{ itoa(len(q.Items)) }</span>
				<span class="panel__meta mono" style="margin-left:auto" title={ q.Root }>{ q.Root }</span>
			</div>
			if len(q.Items) == 0 {
				<p class="panel__meta" data-todo-empty data-i18n="todo.empty">The backlog queue is empty.</p>
			} else {
				// 세 상태를 모두 싣는다(결정 G-5). queued 만 보여주는 작업 화면으로는
				// "그 카드 어디로 갔나"에 답할 수 없어서, 감사 화면 쪽을 골랐다.
				<div class="tbl">
					<div class="tr tr--head" style="grid-template-columns:70px minmax(0,1fr) 90px 210px">
						<span data-i18n="todo.id">ID</span>
						<span data-i18n="todo.text">Card</span>
						<span data-i18n="todo.state">State</span>
						<span>SPEC</span>
					</div>
					for _, it := range q.Items {
						<div class="tr" data-todo-row style="grid-template-columns:70px minmax(0,1fr) 90px 210px">
							<span class="mono">{ it.ID }</span>
							<span>{ it.Text }</span>
							<span>@todoStateBadge(it.State)</span>
							if it.SpecID != "" {
								<span class="mono panel__meta">{ it.SpecID }</span>
							} else {
								<span>@missing()</span>
							}
						</div>
					}
				</div>
			}
		</section>
	}
}

// todoStateBadge 는 항목의 상태를 뱃지로 명시한다. 결정 G-5 의 나머지 절반이다 —
// 감사 화면이라면 카드가 어느 상태인지 말해야 하고, 그러지 않으면 완전한 목록도
// 그냥 구분 없는 목록일 뿐이다.
templ todoStateBadge(state string) {
	<span
		class={ "badge", templ.KV("badge--outline", state == "queued"), templ.KV("badge--strong", state == "picked"), templ.KV("badge--danger", state == "dropped") }
		data-todo-state={ state }
	>{ state }</span>
}

/* ── SPEC 목록 + 슬라이드 패널 ─────────────────────────── */

templ Specs(vm ShellVM, l SpecListVM) {
	@Shell(vm) {
		<div class="toolbar">
			<form class="search" action="/specs" method="get" role="search">
				@iconAt("search", 15)
				<input class="in" type="search" name="q" value={ l.Query } placeholder="Search ID or title" data-i18n-placeholder="specs.search"/>
			</form>
			<div class="chips" role="group" aria-label="Status filter">
				for _, f := range l.Filters {
					// 칩의 개수는 {0} 자리로 주입한다 — 라벨과 개수의 어순은 사전
					// 값이 정한다("all {0}" / "전체 {0}").
					<a
						class="chip"
						href={ templ.SafeURL(f.Href) }
						aria-pressed={ attrBool(f.Active) }
						data-i18n={ "specs.filter." + i18nSlug(f.Label) }
						data-i18n-params={ itoa(f.Count) }
					>{ f.Label + " " + itoa(f.Count) }</a>
				}
			</div>
		</div>
		// 주의가 필요한 것부터 위에 둔다. 목록 아래에 두면 카탈로그가 수백 줄일 때
		// 화면 3만 픽셀 아래로 밀려나 사실상 없는 것과 같아진다.
		@closeDebtPanel(l.CloseDebt)
		@mustFixPanel(l.MustFix)
		<div class="splitpane">
			<div class="tbl" data-live="spec">
				<div class="tr tr--head" style="grid-template-columns:230px minmax(0,1fr) 118px 44px 54px 92px 92px">
					<span>ID</span><span data-i18n="specs.title">Title</span><span>status</span><span>Tier</span><span>era</span>
					<span data-i18n="specs.updated">Updated</span><span data-i18n="specs.drift">Drift</span>
				</div>
				for _, s := range l.Rows {
					<a
						class={ "tr", "tr--link", templ.KV("tr--sel", s.ID == l.SelectedID) }
						href={ templ.SafeURL("/specs?id=" + s.ID) }
						style="grid-template-columns:230px minmax(0,1fr) 118px 44px 54px 92px 92px"
					>
						<span class="tr__name">{ s.ID }</span>
						<span class="tr__desc">{ s.Title }</span>
						<span class="mono" style="font-size:11.5px;display:flex;align-items:center;gap:6px">
							@stateMark(specDotState(s.Status), "")
							{ s.Status }
						</span>
						<span>
							if s.Tier != "" {
								@badge("outline", s.Tier)
							}
						</span>
						<span class="mono panel__meta">{ s.Era }</span>
						<span class="mono panel__meta">{ s.Updated }</span>
						<span>
							if s.Drift != "" {
								@badge(driftKind(s.Drift), s.Drift)
							} else {
								<span class="panel__meta">—</span>
							}
						</span>
					</a>
				}
			</div>
			if l.Detail != nil {
				@specDetail(*l.Detail)
			}
		</div>
	}
}

// closeDebtPanel — 구현은 끝났는데 lifecycle 이 닫히지 않은 SPEC. 구 /specs/board
// 페이지가 하던 일이며, 별도 라우트로 두면 어디서도 링크되지 않아 주소를 직접
// 쳐야만 닿았다.
//
// 목록이 비어 있으면 "없다"고 적는다 — 빈 패널을 그대로 두면 "아직 못 읽었다"로
// 읽힌다. 반대로 길면 앞의 몇 건만 보이고, 잘랐다는 사실과 전체 수를 함께
// 적는다: 조용히 자르면 "이게 전부"로 읽힌다.
templ closeDebtPanel(rows []SpecRowVM) {
	@panel("Close debt", itoa(len(rows)), "", "", "Implementation landed; the lifecycle was never closed to completed.", "roomy") {
		if len(rows) == 0 {
			<p class="panel__meta" data-i18n="board.closedebt.empty">No close-debt SPECs.</p>
		} else {
			<div class="rows">
				for _, s := range boundedRows(rows) {
					@specRowLink(s)
				}
			</div>
			if len(rows) > closeDebtShown {
				<p class="panel__meta">
					// 잘라낸 사실을 밝히는 문장 — 개수 둘({0} 표시 수, {1} 전체 수)은
					// params 로 주입하고 문장 틀만 사전이 번역한다.
					<span data-i18n="board.closedebt.showing" data-i18n-params={ itoa(closeDebtShown) + "," + itoa(len(rows)) }>
						Showing the { itoa(closeDebtShown) } most recently updated of { itoa(len(rows)) + ". " }
					</span>
					<a href="/specs?status=implemented" data-i18n="board.closedebt.all">See all</a>
				</p>
			}
		}
	}
}

// mustFixPanel — 조치 명령을 동반한 MUST-FIX drift. 명령은 복사만 한다.
// 콘솔은 서버에서 아무 명령도 실행하지 않는다 (REQ-WC11-043/044).
templ mustFixPanel(findings []MustFixVM) {
	@panel("Must-fix drift", itoa(len(findings)), "", "", "Copy the command and run it in your own terminal — the console never executes it.", "roomy") {
		if len(findings) == 0 {
			<p class="panel__meta" data-i18n="board.mustfix.empty">No must-fix drift.</p>
		} else {
			<div class="rows">
				for _, f := range findings {
					<div class="row-link">
						@badge("danger", "MUST-FIX")
						<a class="mono" style="flex:0 0 210px;font-size:11.5px" href={ templ.SafeURL("/specs?id=" + f.SpecID) }>{ f.SpecID }</a>
						<span class="panel__meta" style="flex:0 0 150px">{ f.FindingType }</span>
						if f.Remediation != "" {
							<code class="key" style="flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{ f.Remediation }</code>
							<button class="btn btn--outline" type="button" data-copy={ f.Remediation } aria-label="Copy remediation command">
								<span data-i18n="board.copy">Copy</span>
							</button>
						}
					</div>
				}
			</div>
		}
	}
}

templ specDetail(d SpecDetailVM) {
	<aside class="slide" aria-label="SPEC detail">
		<div class="slide__h">
			<div>
				<span class="mono panel__meta">{ d.ID }</span>
				<h2 class="panel__title">{ d.Title }</h2>
			</div>
			<a class="icon-btn" href="/specs" aria-label="Close">@iconAt("close", 13)</a>
		</div>
		<div class="slide__b">
			<ul class="kv">
				<li><span>status</span><b class="mono">{ d.Status }</b></li>
				<li><span>tier</span><b class="mono">{ d.Tier }</b></li>
				<li><span>era</span><b class="mono">{ d.Era }</b></li>
			</ul>
			<div>
				<span class="slide__st" data-i18n="specs.docs">Documents</span>
				<div class="docs">
					for _, f := range d.Docs {
						<span class="doc"><span>{ f }</span>@iconAt("external", 13)</span>
					}
				</div>
				<p class="mono panel__meta">{ d.Path }</p>
			</div>
			if len(d.Findings) > 0 {
				<div>
					<span class="slide__st">{ "drift " + itoa(len(d.Findings)) }</span>
					for _, f := range d.Findings {
						<div class="sess">
							@badge(driftKind(f.Severity), f.Severity)
							<p style="margin:6px 0 0">{ f.Message }</p>
							<span class="mono panel__meta">{ f.File }</span>
						</div>
					}
				</div>
			}
		</div>
	</aside>
}

/* ── 모니터 ─────────────────────────────────────────── */

templ Monitor(vm ShellVM, m MonitorVM) {
	@Shell(vm) {
		<div class="quad">
			@panel("Sessions", "registry "+itoa(len(m.Sessions)), "", "", "Only PID-confirmed entries are marked active.", "roomy") {
				<div class="tbl" data-live="session">
					<div class="tr tr--head" style="grid-template-columns:110px minmax(0,1fr) 86px 130px">
						<span data-i18n="monitor.session">Session</span><span>SPEC</span>
						<span data-i18n="kanban.backend">Backend</span><span data-i18n="monitor.heartbeat">Heartbeat</span>
					</div>
					for _, s := range m.Sessions {
						<div class="tr" style="grid-template-columns:110px minmax(0,1fr) 86px 130px">
							<span class="mono" style="display:flex;align-items:center;gap:6px">
								@stateMark(s.State, "")
								{ s.ID }
							</span>
							<span class="mono panel__meta">{ s.SpecID }</span>
							<span>@backendBadge(s.Backend)</span>
							<span class="panel__meta">{ s.Heartbeat }</span>
						</div>
					}
				</div>
				<p class="panel__help">{ "cwd " + m.Cwd }</p>
			}
			@panel("Goals", "armed "+itoa(len(m.Goals)), "", "", ".moai/state/goal/<session>.json", "roomy") {
				<div data-live="goal">
					for _, g := range m.Goals {
						<div style="display:flex;flex-direction:column;gap:6px;margin-top:12px">
							<div style="display:flex;align-items:center;gap:10px">
								<span class="mono">{ g.Session }</span>
								if g.Stalled {
									@badge("outline", "stalled")
								}
							</div>
							<p style="margin:0">{ g.Condition }</p>
							<div class="vrow" style="border:0;padding:0">
								<span class="panel__meta" data-i18n="monitor.turns">Turns</span>
								<span class="bar"><span style={ "width:" + itoa(g.TurnPct) + "%" }></span></span>
								<span class="mono panel__meta">{ itoa(g.Turns) }</span>
							</div>
							<p class="panel__meta">{ g.Verdict }</p>
						</div>
					}
				</div>
			}
			@panel("Verification", itoa(m.VerifyKeys)+" keys", "", "", "", "roomy") {
				<div class="vlist" data-live="verify">
					for _, v := range m.Verify {
						<div class="vrow">
							<span class="mono">{ v.Key }</span>
							@spark(v.History)
							if v.OK {
								<span class="panel__meta" data-i18n="monitor.pass">Pass</span>
							} else {
								<span class="warn" data-i18n="monitor.fail">Fail</span>
							}
							<span class="panel__meta">{ v.When }</span>
						</div>
					}
				</div>
			}
			@panel("Epics", "moai epic status", "", "", "", "roomy") {
				<div class="vlist">
					for _, e := range m.Epics {
						<div class="vrow">
							<span class="mono">{ e.Prefix }</span>
							<span class="bar"><span style={ "width:" + itoa(e.Pct) + "%" }></span></span>
							<span class="mono panel__meta">{ e.Progress }</span>
						</div>
					}
				</div>
			}
		</div>
	}
}
