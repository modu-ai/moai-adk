package web

import (
	"strconv"
	"strings"

	"github.com/modu-ai/moai-adk/internal/config"
	"github.com/modu-ai/moai-adk/internal/settings"
	"github.com/modu-ai/moai-adk/internal/settings/agentfm"
)

// 설정 패널과 행 위젯. 재설계에서 마크업 어휘가 §4-§7 로 옮겨졌다:
// .section → .panel · .field__title → .field__label · .field__desc → .field__help ·
// .field-error → .field__err · .input → .in · .select → .sel · .radio-group → .seg ·
// .field__key → .key. 옮긴 것은 클래스 이름과 요소 배치뿐이고, name 속성 ·
// id · data-i18n 키 · option value · hidden companion 은 전부 그대로다 — 저장
// 경로는 이 파일 바깥(handlers.go / schemaform.go)이 소유한다.
//
// 필드 라벨은 사람이 읽는 제목 + 기술 식별자 칩(.key)의 쌍이다. 칩은 번역하지
// 않는다 (i18n.js 계약: "Field identifiers stay in English as code chips").

// panelChrome 은 설정 패널 하나의 머리글 정보다. Count 는 필드 수이고, 밀도는
// 여기서 파생된다 — 필드가 많은 탭은 라벨을 좌측에 고정한 조밀 배치로 접힌다
// (§6 의 밀도 2종).
type panelChrome struct {
	Icon     string
	TitleKey string
	Title    string
	DescKey  string
	Desc     string
	Count    int
}

// panelDensity 는 필드 수로 밀도를 고른다. 경계값 7 은 §6 이 정한 값이다.
func panelDensity(count int) string {
	if count >= 7 {
		return "dense"
	}
	return "roomy"
}

templ settingsPanel(p panelChrome) {
	<section class="panel" data-density={ panelDensity(p.Count) }>
		<div class="panel__head">
			<h2 class="panel__title">
				<span class="panel__ico">@icon(p.Icon)</span>
				<span data-i18n={ p.TitleKey }>{ p.Title }</span>
			</h2>
			@sectionCount(p.Count)
		</div>
		<p class="panel__help" data-i18n={ p.DescKey }>{ p.Desc }</p>
		{ children... }
	</section>
}

// sectionCount renders a panel field-count label DERIVED from the schema length
// (SPEC-WEB-CONSOLE-011 B11 — no hardcoded "N fields" literals; the unit suffix
// is i18n-keyed so 4-locale rendering is preserved).
templ sectionCount(n int) {
	<span class="panel__meta">{ strconv.Itoa(n) } <span data-i18n="count.fields">field(s)</span></span>
}

// fieldsetIdentity ports the Identity panel (user_name text input).
templ fieldsetIdentity(view pageView) {
	@settingsPanel(panelChrome{
		Icon: "user-round", TitleKey: "sec.identity.title", Title: "Identity",
		DescKey: "sec.identity.desc", Desc: "Who you are in commits and sessions.",
		Count: len(settings.SectionFields(settings.SectionIdentity)),
	}) {
		<div class="field">
			@fieldHead("user_name", "Display name", "user_name")
			<p class="field__help" data-i18n="f.user_name.desc">The name shown in commits and session headers.</p>
			<div class="field__ctl">
				if hasFieldError(view.FieldErrors, "user_name") {
					<input class="in" type="text" id="user_name" name="user_name" value={ view.Prefs.UserName } placeholder="e.g. jline" autocomplete="off" aria-invalid="true" aria-describedby="err_user_name"/>
				} else {
					<input class="in" type="text" id="user_name" name="user_name" value={ view.Prefs.UserName } placeholder="e.g. jline" autocomplete="off"/>
				}
			</div>
			@fieldErr(view.FieldErrors, "user_name")
		</div>
	}
}

// fieldsetLanguage ports the Language panel (4x langSelect).
templ fieldsetLanguage(view pageView) {
	@settingsPanel(panelChrome{
		Icon: "languages", TitleKey: "sec.language.title", Title: "Language",
		DescKey: "sec.language.desc", Desc: "Languages used across conversation, commits, comments, and docs.",
		Count: len(settings.SectionFields(settings.SectionLanguage)),
	}) {
		@langSelect(langSelectArgs{Name: "conversation_lang", Title: "Conversation language", Key: "conversation_lang", Desc: "Language the assistant replies in during chat.", Value: view.Prefs.ConversationLang, Options: view.LangOptions, Errors: view.FieldErrors})
		@langSelect(langSelectArgs{Name: "git_commit_lang", Title: "Commit message language", Key: "git_commit_lang", Desc: "Language used when writing git commit messages.", Value: view.Prefs.GitCommitLang, Options: view.LangOptions, Errors: view.FieldErrors})
		@langSelect(langSelectArgs{Name: "code_comment_lang", Title: "Code comment language", Key: "code_comment_lang", Desc: "Language for comments written into your code.", Value: view.Prefs.CodeCommentLang, Options: view.LangOptions, Errors: view.FieldErrors})
		@langSelect(langSelectArgs{Name: "doc_lang", Title: "Documentation language", Key: "doc_lang", Desc: "Language for generated docs and READMEs.", Value: view.Prefs.DocLang, Options: view.LangOptions, Errors: view.FieldErrors})
	}
}

// fieldsetLaunch ports the Launch panel: an inline permission_mode select (with
// the "(project default)" empty-option-when-blank logic) + 2x optSelect
// (model / effort_level).
templ fieldsetLaunch(view pageView) {
	@settingsPanel(panelChrome{
		Icon: "rocket", TitleKey: "sec.launch.title", Title: "LLM",
		DescKey: "sec.launch.desc", Desc: "How sessions start — permissions, model, and reasoning effort.",
		Count: len(settings.SectionFields(settings.SectionLaunch)),
	}) {
		<div class="field">
			@fieldHead("permission_mode", "Permission mode", "permission_mode")
			<p class="field__help" data-i18n="f.permission_mode.desc">How much the agent may do before asking you.</p>
			<div class="field__ctl">
				<select
					class="sel"
					id="permission_mode"
					name="permission_mode"
					if hasFieldError(view.FieldErrors, "permission_mode") {
						aria-invalid="true"
						aria-describedby="err_permission_mode"
					}
				>
					for _, m := range view.PermissionModes {
						@permissionOption(m, view.Prefs.PermissionMode)
					}
				</select>
			</div>
			@fieldErr(view.FieldErrors, "permission_mode")
		</div>
		@optSelect(optSelectArgs{Name: "model", Title: "Model", Key: "model", Desc: "The specific model to run.", Value: view.Prefs.Model, Empty: settings.EmptyLabelFor("model"), EmptyKey: settings.EmptyLabelKeyFor("model"), Options: view.ModelOptions, Errors: view.FieldErrors})
		@optSelect(optSelectArgs{Name: "effort_level", Title: "Effort level", Key: "effort_level", Desc: "How much reasoning effort the model spends per task.", Value: view.Prefs.EffortLevel, Empty: settings.EmptyLabelFor("effort_level"), EmptyKey: settings.EmptyLabelKeyFor("effort_level"), Options: view.EffortLevels, Errors: view.FieldErrors})
	}
}

// permissionOption ports the permission_mode option rendering: an empty value
// renders "(project default)", otherwise the value itself; the current value is
// marked selected. M5-b D4: OptionDef 를 받아 data-i18n 키를 방출한다.
templ permissionOption(opt settings.OptionDef, current string) {
	if opt.Value == current {
		if opt.Value == "" {
			<option value="" selected data-i18n="opt.project_default">(project default)</option>
		} else {
			<option value={ opt.Value } selected data-i18n={ opt.I18nKey }>{ opt.Value }</option>
		}
	} else {
		if opt.Value == "" {
			<option value="" data-i18n="opt.project_default">(project default)</option>
		} else {
			<option value={ opt.Value } data-i18n={ opt.I18nKey }>{ opt.Value }</option>
		}
	}
}

// ─── SPEC-WEB-CONSOLE-011 M2b: 10섹션 확장의 제네릭 스키마 패널 ───────────────

// fieldsetSchemaSection은 확장 섹션 하나를 스키마 주도로 렌더한다: 편집 스칼라
// 필드(REQ-WC11-016) + read-only 표시 키(REQ-WC11-013/019) + collapsed raw view
// 서브블록(REQ-WC11-062).
templ fieldsetSchemaSection(view pageView, meta schemaSectionMeta) {
	@settingsPanel(panelChrome{
		Icon: meta.Icon, TitleKey: meta.TitleKey, Title: meta.Title,
		DescKey: meta.DescKey, Desc: meta.Desc, Count: len(meta.Fields),
	}) {
		// 패널 단위 주의 문구는 머리글에 한 번만 쓴다. 패널의 모든 필드에 공통으로
		// 걸리는 사실을 필드마다 되풀이하지 않는다 (REQ-WCR M4).
		if meta.NoteKey != "" {
			<p class="panel__help" data-i18n={ meta.NoteKey }>{ meta.Note }</p>
		}
		for _, f := range meta.Fields {
			@schemaFieldWidget(view, f)
		}
		for _, ro := range settings.ReadOnlyDisplayFields() {
			if meta.Extras && ro.Section == meta.ID {
				@schemaReadOnlyRow(ro.Name, view.SchemaValues[ro.Name], ro.NoteKey)
			}
		}
		// SPEC-GLM-KEY-INPUT-001 M3: the GLM API key control is a hand-built
		// secret-class field rendered inside the 3rd Party LLM section, adjacent to
		// the GLM model tier fields. It is NOT a settings.FieldDef — D-2 keeps it
		// out of AllFields() so no generic schema loop can ever pick it up.
		if glmKeyFieldBelongsToLLMSection(meta.ID) {
			@fieldsetGLMKey(view)
		}
		for _, rb := range settings.RawViewBlocks() {
			if meta.Extras && rb.Section == meta.ID {
				@schemaRawBlock(rb.Name, view.RawBlocks[rb.Name], rb.NoteKey)
			}
		}
	}
}

// fieldsetGLMKey renders the GLM API key control. It is a secret-class input:
// type="password" masks typed characters; autocomplete="off" opts out of
// browser autofill; the value attribute is UNCONDITIONALLY empty so a stored
// key is never echoed back into the form (REQ-GKI-004-001 / plan §G AP-2).
// The presence indicator surfaces at most the final four characters of a
// stored key (REQ-GKI-004-002), and nothing for a key of four characters or
// fewer (REQ-GKI-004-004 / plan §G AP-2c).
templ fieldsetGLMKey(view pageView) {
	<div class="field">
		<div class="field__head">
			<span class="field__label" data-i18n="f.glm_api_key.title">GLM API key</span>
			<code class="key">~/.moai/.env.glm</code>
		</div>
		<p class="field__help" data-i18n="f.glm_api_key.desc">Credential for the GLM backend. Stored at mode 0600 outside the project tree; never echoed back.</p>
		<div class="field__ctl">
			<input
				class="in"
				type="password"
				id={ glmAPIKeyFormField }
				name={ glmAPIKeyFormField }
				autocomplete="off"
				value=""
				if hasFieldError(view.FieldErrors, glmAPIKeyFormField) {
					aria-invalid="true"
					aria-describedby={ "err_" + glmAPIKeyFormField }
				}
			/>
			if view.GLMKeyConfigured {
				<p class="field__help">
					@iconAt("check", 13)
					<span data-i18n="f.glm_api_key.configured">Configured</span>
					if view.GLMKeyHint != "" {
						<code class="key">…{ view.GLMKeyHint }</code>
					}
				</p>
				// REQ-WCR-034: explicit reveal. The default render still carries
				// value="" above — this control fetches the plaintext from the server
				// only when clicked, so the never-echo contract on the page itself is
				// untouched. Rendered only when a key is actually stored; there is
				// nothing to reveal otherwise.
				<p class="field__help">
					<button
						class="btn btn--ghost"
						type="button"
						id="glmKeyReveal"
						data-reveal-url={ glmKeyRevealPath }
						data-i18n="f.glm_api_key.reveal"
					>Show stored key</button>
					<code class="key" id="glmKeyRevealed" hidden></code>
				</p>
			}
		</div>
		@fieldErr(view.FieldErrors, glmAPIKeyFormField)
	</div>
}

// schemaFieldWidget은 FieldDef.Type에 따라 위젯을 선택한다.
templ schemaFieldWidget(view pageView, f settings.FieldDef) {
	switch f.Type {
		case settings.TypeBool:
			@schemaToggleRow(f, view.SchemaValues[f.Name] == "true")
		case settings.TypeSelect:
			@schemaSelectRow(f, view.SchemaValues[f.Name], view.FieldErrors)
		case settings.TypeRadio:
			@schemaRadioRow(f, view.SchemaValues[f.Name], view.FieldErrors)
		case settings.TypeInt:
			@schemaNumberRow(f, view.SchemaValues[f.Name], "1", view.FieldErrors)
		case settings.TypeFloat:
			@schemaNumberRow(f, view.SchemaValues[f.Name], "0.01", view.FieldErrors)
		default:
			@schemaTextRow(f, view.SchemaValues[f.Name], view.FieldErrors)
	}
}

// fieldDescription renders the REQ-WC-015 field-level description: a muted
// helper line below the control, resolved client-side from the
// FieldDef.Description i18n key. Empty Description = nothing rendered.
templ fieldDescription(f settings.FieldDef) {
	if f.Description != "" {
		<p class="field__help" data-i18n={ f.Description }></p>
	}
}

// schemaFieldHead 는 스키마 필드의 라벨 줄이다. 배지 두 종(선언적 힌트 ·
// 저장만 되고 적용되지 않음)이 붙을 수 있다.
templ schemaFieldHead(f settings.FieldDef) {
	<div class="field__head">
		<span class="field__label" data-i18n={ f.I18nKey + ".title" }>{ schemaFieldTitle(f) }</span>
		<code class="key">{ f.Name }</code>
		// REQ-WCR-033: 값이 저장은 되지만 어떤 런타임 경로도 읽지 않는 필드는 행에서
		// 그렇다고 말한다. 이름 매칭이 아니라 FieldDef.StoreOnly 로 구동하므로
		// 위젯은 필드에 무지한 채로 남는다.
		if f.StoreOnly {
			<span class="badge badge--outline" data-store-only={ f.Name } data-i18n="badge.store_only">Stored only — not applied at runtime</span>
		}
	</div>
}

// schemaTextRow — 자유 텍스트. EmptyLabel이 있으면 placeholder로 렌더한다
// (빈 값의 "(runtime default)" 시맨틱 — REQ-WC11-014/EC-4).
templ schemaTextRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class="field">
		@schemaFieldHead(f)
		<p class="field__help" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</p>
		<div class="field__ctl">
			// aria-invalid 는 접근성 표식이면서 동시에 오류 테두리의 스타일 훅이다
			// (§6 의 .in[aria-invalid="true"]). 둘을 한 속성에 묶어 두면 "보이는
			// 오류"와 "읽히는 오류"가 갈라질 수 없다.
			<input
				class="in"
				type="text"
				id={ f.Name }
				name={ f.Name }
				value={ value }
				placeholder={ f.EmptyLabel }
				autocomplete="off"
				if hasFieldError(errs, f.Name) {
					aria-invalid="true"
					aria-describedby={ "err_" + f.Name }
				}
			/>
		</div>
		@fieldErr(errs, f.Name)
	</div>
}

// schemaNumberRow — 정수/실수 입력.
templ schemaNumberRow(f settings.FieldDef, value, step string, errs map[string]string) {
	<div class="field">
		@schemaFieldHead(f)
		<p class="field__help" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</p>
		<div class="field__ctl">
			<input
				class="in"
				type="number"
				id={ f.Name }
				name={ f.Name }
				value={ value }
				step={ step }
				autocomplete="off"
				if hasFieldError(errs, f.Name) {
					aria-invalid="true"
					aria-describedby={ "err_" + f.Name }
				}
			/>
		</div>
		@fieldErr(errs, f.Name)
	</div>
}

// schemaToggleRow — bool 필드. 사용 / 미사용 2분할 세그먼트로 렌더한다
// (REQ-WCR-020). 체크박스는 "체크 안 함"과 "이 필드를 못 봤음"을 화면상 구분해
// 주지 못했다 — 세그먼트는 언제나 한 칸이 채워져 있어 두 상태를 눈에 보이게 만든다.
//
// hidden __present companion은 그대로 유지된다 (REQ-WCR-021): "미사용" 옵션의
// value가 빈 문자열이라 PostFormValue가 ""를 돌려주고, parseSchemaForm의 기존
// bool 분기가 무변경으로 false를 기록한다. 필드가 아예 제출되지 않으면 companion도
// 없으므로 "값 보존"으로 읽힌다.
//
// 부작용(의도적으로 수용): 지금까지 키 부재였던 bool 필드는 첫 저장 시 명시적
// true/false로 기록된다 — 세그먼트는 언제나 하나가 선택되기 때문이다.
templ schemaToggleRow(f settings.FieldDef, checked bool) {
	<div class="field">
		@schemaFieldHead(f)
		<p class="field__help" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</p>
		<div class="field__ctl">
			@boolSegment(f.Name, checked)
		</div>
		@fieldDescription(f)
	</div>
}

// boolSegment 는 사용 / 미사용 2분할 세그먼트다. bool 필드를 쓰는 세 자리
// (스키마 필드 · MCP 도구 · codex 옵트인)가 같은 제출 계약을 공유하도록 한 곳에
// 모았다: hidden companion + value="1" / value="" 라디오 쌍.
templ boolSegment(name string, checked bool) {
	<input type="hidden" name={ name + "__present" } value="1"/>
	<div class="seg">
		<label class="seg__b">
			<input type="radio" id={ name + "--on" } name={ name } value="1" checked?={ checked }/>
			<span data-i18n="opt.enabled">Used</span>
		</label>
		<label class="seg__b">
			<input type="radio" id={ name + "--off" } name={ name } value="" checked?={ !checked }/>
			<span data-i18n="opt.disabled">Not used</span>
		</label>
	</div>
}

// schemaSelectRow — 닫힌 옵션 select. EmptyLabel이 있으면 빈 옵션을 렌더한다.
// effort 필드에는 선언적 힌트를 덧붙인다 — Go 런타임이 행동적으로 바인딩하지
// 않는 값임을 알린다. baseline 텍스트는 영어다: 하드코딩된 한국어는 JS 미실행
// 렌더에서 모든 로케일에 한국어를 노출했다.
templ schemaSelectRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class="field">
		@schemaFieldHead(f)
		<p class="field__help" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</p>
		if strings.HasSuffix(f.Name, ".effort") {
			<p class="field__help" data-i18n="hint.effort.go_unbound">Resolved from the performance tier above — per-agent edits save as overrides.</p>
		}
		<div class="field__ctl">
			<select
				class="sel"
				id={ f.Name }
				name={ f.Name }
				if hasFieldError(errs, f.Name) {
					aria-invalid="true"
					aria-describedby={ "err_" + f.Name }
				}
			>
				if f.EmptyLabel != "" {
					if value == "" {
						<option value="" selected data-i18n={ f.EmptyLabelKey }>{ f.EmptyLabel }</option>
					} else {
						<option value="" data-i18n={ f.EmptyLabelKey }>{ f.EmptyLabel }</option>
					}
				}
				for _, opt := range f.Options {
					if opt.Value == selectedSchemaValue(f, value) {
						<option value={ opt.Value } selected data-i18n={ opt.I18nKey } data-i18n-title={ f.Description + ".option." + opt.Value }>{ opt.Value }</option>
					} else {
						<option value={ opt.Value } data-i18n={ opt.I18nKey } data-i18n-title={ f.Description + ".option." + opt.Value }>{ opt.Value }</option>
					}
				}
			</select>
		</div>
		@fieldDescription(f)
		@fieldErr(errs, f.Name)
	</div>
}

// schemaRadioRow — 닫힌 옵션 세그먼트. EmptyLabel이 있으면 빈 옵션을 렌더한다.
//
// Layout opt-in: when ANY option carries a per-option description
// (OptionDef.OptionDesc), the segment renders VERTICAL with the description
// beside each option (seg--stacked). This is the report.format shape only —
// every other radio (merge_method etc.) leaves OptionDesc empty and stays on the
// default horizontal segment. The branch is value-driven (no flag field), so
// unrelated fields are untouched.
templ schemaRadioRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class="field">
		@schemaFieldHead(f)
		<p class="field__help" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</p>
		<div class="field__ctl">
			if hasRadioOptionDesc(f.Options) {
				<div class="seg seg--stacked">
					for _, opt := range f.Options {
						<label class="seg__b">
							if opt.Value == value {
								<input type="radio" id={ f.Name + "--" + opt.Value } name={ f.Name } value={ opt.Value } checked/>
							} else {
								<input type="radio" id={ f.Name + "--" + opt.Value } name={ f.Name } value={ opt.Value }/>
							}
							<span data-i18n={ opt.I18nKey }>{ opt.Value }</span>
							<span class="seg__d" data-i18n={ opt.OptionDesc }></span>
						</label>
					}
				</div>
			} else {
				<div class="seg">
					if f.EmptyLabel != "" {
						<label class="seg__b">
							if value == "" {
								<input type="radio" id={ f.Name + "--empty" } name={ f.Name } value="" checked/>
							} else {
								<input type="radio" id={ f.Name + "--empty" } name={ f.Name } value=""/>
							}
							<span data-i18n={ f.EmptyLabelKey }>{ f.EmptyLabel }</span>
						</label>
					}
					for _, opt := range f.Options {
						<label class="seg__b">
							if opt.Value == value {
								<input type="radio" id={ f.Name + "--" + opt.Value } name={ f.Name } value={ opt.Value } checked/>
							} else {
								<input type="radio" id={ f.Name + "--" + opt.Value } name={ f.Name } value={ opt.Value }/>
							}
							<span data-i18n={ opt.I18nKey } data-i18n-title={ f.Description + ".option." + opt.Value }>{ opt.Value }</span>
						</label>
					}
				</div>
			}
		</div>
		@fieldDescription(f)
		@fieldErr(errs, f.Name)
	</div>
}

// schemaReadOnlyRow — read-only 표시 키 (REQ-WC11-013/019). form 컨트롤을 일절
// 렌더하지 않으므로 제출 자체가 불가능하다 — 파일 값 불변이 구조적으로 보장된다.
// noteKey가 비어 있으면 제네릭 "ro.note"를, 아니면 정직한 설명 라벨 키를 방출한다.
templ schemaReadOnlyRow(name, value, noteKey string) {
	<div class="field field--ro">
		<div class="field__head">
			<code class="key">{ name }</code>
			<span class="field__label" data-i18n={ roNoteKey(noteKey) }>{ roNoteBaseline(noteKey) }</span>
		</div>
		<div class="field__ctl">
			<span class="in in--ro">{ value }</span>
		</div>
	</div>
}

// schemaRawBlock — form UI에 맞지 않는 map/list 서브블록의 collapsed raw view
// (REQ-WC11-062). input 컨트롤 0 — <pre> 텍스트 표시만.
templ schemaRawBlock(name, content, noteKey string) {
	<details class="raw">
		<summary>
			<code class="key">{ name }</code>
			<span data-i18n={ rawNoteKey(noteKey) }>{ rawNoteBaseline(noteKey) }</span>
		</summary>
		<pre class="raw__pre">{ content }</pre>
	</details>
}

// ─── SPEC-WEB-CONSOLE-011 M3: sub-agent frontmatter 편집 표 ──────────────────

// fieldsetAgentFrontmatter는 .claude/agents/moai/ sub-agent의 model/effort
// frontmatter 편집 표를 렌더한다. 지속 경고("moai update가 덮어쓸 수 있음",
// REQ-WC11-028) + llm 교차 참조 + dynamic-workflows taxonomy 참조(REQ-WC11-026)를
// 포함한다. effort의 "(absent)" 옵션은 키 삭제를 의미한다 (EC-7).
//
// harness 행은 렌더하지 않는다. 스캔 자체는 그대로라 미렌더 agent는 폼 값을
// 제출하지 않고, parseAgentFMForm이 이를 "preserve"로 읽으므로 harness
// frontmatter는 기록되지 않는다.
templ fieldsetAgentFrontmatter(view pageView) {
	@settingsPanel(panelChrome{
		Icon: "user-round", TitleKey: "sec.agentfm.title", Title: "Agents",
		DescKey: "sec.agentfm.desc",
		Desc:    "Per-agent model/effort frontmatter of the live agent files (frontmatter-only writes; bodies untouched).",
		Count:   agentFMRenderCount(view.AgentFMs),
	}) {
		<p class="banner banner--warn" role="alert">
			@iconAt("alert", 14)
			<span data-i18n="agentfm.warn">These files are template-managed — a later `moai update` may overwrite live edits.</span>
		</p>
		<p class="panel__help" data-i18n="agentfm.llmnote">Per-agent model/effort here follows the performance tier above. GLM backend tiers are in the 3rd Party LLM section.</p>
		<p class="panel__help">
			<span data-i18n="agentfm.taxonomy">workflow_agents purpose defaults follow the purpose taxonomy in</span>
			<code class="key">.claude/rules/moai/workflow/dynamic-workflows.md</code>
		</p>
		<div class="field">
			<div class="field__head">
				<span class="field__label" data-i18n="agentfm.tier.title">Performance tier</span>
				<code class="key">llm.performance_tier</code>
			</div>
			<p class="field__help" data-i18n="agentfm.tier.desc">Sets each sub-agent's model/effort from this tier column (max / medium / low). Per-agent edits below are saved as overrides and shown as Custom.</p>
			<div class="field__ctl">
				<div class="seg">
					for _, opt := range agentFMPerfTierOptions() {
						<label class="seg__b">
							if !view.PerfTierCustom && (opt == view.PerfTier || (view.PerfTierIsEmpty && opt == "medium")) {
								<input type="radio" id={ "performance_tier--" + opt } name="performance_tier" value={ opt } checked/>
							} else {
								<input type="radio" id={ "performance_tier--" + opt } name="performance_tier" value={ opt }/>
							}
							<span>{ opt }</span>
						</label>
					}
					<label class="seg__b">
						if view.PerfTierCustom {
							<input type="radio" id="performance_tier--custom" name="performance_tier" value="custom" checked/>
						} else {
							<input type="radio" id="performance_tier--custom" name="performance_tier" value="custom"/>
						}
						<span data-i18n="agentfm.tier.custom">Custom</span>
					</label>
				</div>
			</div>
			if view.PerfTierIsEmpty {
				<p class="field__help" data-i18n="agentfm.tier.default">(runtime default: medium)</p>
			}
			@fieldErr(view.FieldErrors, "performance_tier")
		</div>
		@templ.JSONScript("moai-profile-matrix", profileMatrixData())
		// Single consolidated per-agent explanation, at the table head rather than
		// repeated under every row.
		<p class="panel__help" data-i18n="hint.effort.go_unbound">Resolved from the performance tier above — per-agent edits save as overrides.</p>
		<div class="tbl">
			// Group header rows: emit a divider when the current agent's
			// catalog-class group differs from the previous rendered row's. The
			// render rows (with group-change flags) are precomputed in Go
			// (agentFMGridRows) so the templ loop stays state-free.
			for _, r := range agentFMGridRows(view.AgentFMs) {
				if r.GroupHead != "" {
					<div class="tr tr--group"><span>{ r.GroupHead }</span></div>
				}
				@agentFMRow(r.Agent, view.LLM, view.FieldErrors)
			}
		</div>
	}
}

// agentFMRow는 agent 1종의 model/effort select 쌍이다. 빈 옵션 = 현재값 유지
// (empty=preserve). 파싱 실패 행은 편집 비활성 표시만 한다 (design.md §C.1).
templ agentFMRow(agent agentfm.AgentInfo, llm config.LLMConfig, errs map[string]string) {
	if agent.ParseOK {
		<div class="tr tr--afm" data-agent-row={ agent.Name }>
			<div class="tr__sub">
				<span class="tr__name">
					if agentTierBadge(agent.Name, agent.Model, agent.Effort).HasBadge {
						<span class={ "badge", templ.KV("badge--strong", agentTierBadge(agent.Name, agent.Model, agent.Effort).IsCustom) } data-i18n-title={ agentTierBadge(agent.Name, agent.Model, agent.Effort).TooltipKey }>{ agentTierBadge(agent.Name, agent.Model, agent.Effort).Glyph }</span>
					}
					<code class="key">{ agent.Name }</code>
				</span>
				// The English text is the SERVER-SIDE BASELINE, read from the agent
				// .md frontmatter (the SSOT). agentdesc.<name> carries only the
				// ko/ja/zh translations; en has no such key. data-i18n-baseline pins
				// the server text so applyI18n can RESTORE it when the active locale's
				// dictionary lacks the key — otherwise a KO→EN switch leaves the
				// previous locale's text stuck on the row.
				if short := agentDescriptionShort(agent.Description); short != "" {
					<span class="tr__desc" data-i18n={ "agentdesc." + agent.Name } data-i18n-baseline={ short }>{ short }</span>
				}
			</div>
			<select class="sel" name={ "agentfm." + agent.Name + ".model" } id={ "agentfm." + agent.Name + ".model" } aria-label={ "Model for " + agent.Name }>
				for _, m := range agentFMModelValues() {
					if m == agentSelectedModel(llm, agent) {
						<option value={ m } selected data-i18n-title={ "fieldDesc.agentfm.model." + m }>{ m }</option>
					} else {
						<option value={ m } data-i18n-title={ "fieldDesc.agentfm.model." + m }>{ m }</option>
					}
				}
			</select>
			<div>
				// Haiku does not honor reasoning effort — disable the effort select
				// (initial render, so the no-JS page is correct too). app.js re-toggles
				// this live when the paired model select changes. A disabled select does
				// not submit; parseAgentFMForm backfills the unsubmitted effort.
				<select class="sel" name={ "agentfm." + agent.Name + ".effort" } id={ "agentfm." + agent.Name + ".effort" } aria-label={ "Effort for " + agent.Name } disabled?={ agentModelIsHaiku(llm, agent) }>
					for _, e := range agentFMEffortValues() {
						if e == agentSelectedEffort(llm, agent) {
							<option value={ e } selected data-i18n-title={ "fieldDesc.agentfm.effort." + e }>{ e }</option>
						} else {
							<option value={ e } data-i18n-title={ "fieldDesc.agentfm.effort." + e }>{ e }</option>
						}
					}
				</select>
				// Muted note explaining the disabled effort — present in the DOM always
				// so app.js can toggle it client-side; hidden until the model is haiku.
				<span class="field__help" data-haiku-hint data-i18n="hint.effort.haiku_na" hidden?={ !agentModelIsHaiku(llm, agent) }>Effort N/A for Haiku</span>
			</div>
			@fieldErr(errs, "agentfm."+agent.Name+".model")
			@fieldErr(errs, "agentfm."+agent.Name+".effort")
		</div>
	} else {
		<div class="tr tr--afm">
			<div class="tr__sub">
				<span class="tr__name"><code class="key">{ agent.Name }</code></span>
				<span class="tr__desc" data-i18n="agentfm.unavailable">unavailable (frontmatter parse failed)</span>
			</div>
		</div>
	}
}

// ─── SPEC-MCP-CONSOLE-001 M2: per-tool MCP enablement panel ──────────────────
//
// fieldsetMCP renders the MCP section: one enablement toggle per tool declared
// in the shared catalog (settings.SectionFields(SectionMCP) derives from
// internal/mcp MoaiMCPTools — single declaration, AP-C-4). The four
// write-capable tools carry a TEXT-bearing badge the thirteen read-only tools do
// not (REQ-C-3 / AC-C-003): the distinction rides on the literal string
// "Write-capable", not on colour alone, so it survives a monochrome or
// screen-reader pass.

templ fieldsetMCP(view pageView) {
	@settingsPanel(panelChrome{
		Icon: "plug", TitleKey: "sec.mcp.title", Title: "MCP",
		DescKey: "sec.mcp.desc",
		Desc:    "Per-tool enablement for the self-hosted moai MCP server. A disabled tool is absent from tools/list.",
		Count:   len(settings.SectionFields(settings.SectionMCP)),
	}) {
		for _, f := range settings.SectionFields(settings.SectionMCP) {
			// All-enabled default (owner decision 2026-08-12): an unset key reads as
			// "" and displays as enabled; only an explicit "false" turns it off.
			@mcpToolRow(f, view.SchemaValues[f.Name] != "false")
		}
		// SPEC-MCP-CONSOLE-001 M3 (REQ-C-4/5/6): codex authentication surface. The
		// probe state is CONSUMED from the injected probe (AC-C-006 — not recomputed
		// here). Unauthenticated → names the command (AC-C-007); absent → graceful
		// not-installed state (AC-C-008).
		@codexAuthBlock(view)
		// SPEC-MCP-CONSOLE-001 M4 (REQ-C-7): GLM key state surface. The state is
		// REUSED from the existing view model (view.GLMKeyConfigured / GLMKeyHint,
		// populated by populateGLMKeyHint -> computeGLMKeyHint in glmkey.go —
		// AC-C-010: no second credential path). Only the configured boolean and the
		// bounded trailing-four hint cross in (AC-C-011); no key value, no submit, no
		// reveal (those live in the 3rd Party LLM section).
		@glmKeyStateBlock(view)
	}
}

// glmKeyStateBlock renders the GLM API key STATE inside the MCP section — a
// read-only configured/not-configured indicator plus the bounded trailing-four
// hint. It is state-only by design (REQ-C-7): the credential input + reveal
// surface stays in the 3rd Party LLM section (fieldsetGLMKey); this block does
// not duplicate that path. The hint is already truncated to the final four
// characters (or empty for a key of four characters or fewer) by the time it
// reaches the view model — computeGLMKeyHint enforces that bound before the
// pageView is built, so this template renders only what it is given (AC-C-011).
templ glmKeyStateBlock(view pageView) {
	<div class="cred">
		<span class="cred__t" data-i18n="sec.mcp.glm_key.title">GLM API key</span>
		if view.GLMKeyConfigured {
			<ul class="kv">
				<li>
					<span data-i18n="f.mcp.glm_key.status">Status</span>
					<b data-i18n="f.mcp.glm_key.configured">Configured</b>
				</li>
				if view.GLMKeyHint != "" {
					<li>
						<span data-i18n="f.mcp.glm_key.hint">Last four</span>
						<b><code class="key">…{ view.GLMKeyHint }</code></b>
					</li>
				}
			</ul>
		} else {
			<p class="panel__help" data-i18n="f.mcp.glm_key.not_configured">No GLM API key is configured.</p>
		}
	</div>
}

// codexAuthBlock renders the codex authentication + opt-in toggle surface inside
// the MCP section. It reads the probe state from view.CodexState (injected by
// the CLI layer — no classification logic in internal/web, AC-C-006) and renders
// the two opt-in toggles through the schema seam (AC-C-009 — same path the
// fail-closed readers consume).
templ codexAuthBlock(view pageView) {
	<div class="cred">
		<span class="cred__t" data-i18n="sec.mcp.codex.title">Codex authentication</span>
		if view.CodexState.Installed {
			<ul class="kv">
				<li>
					<span data-i18n="f.mcp.codex.binary">Binary</span>
					<b><code class="mono">{ view.CodexState.Binary }</code></b>
				</li>
				if view.CodexState.Version != "" {
					<li>
						<span data-i18n="f.mcp.codex.version">Version</span>
						<b>{ view.CodexState.Version }</b>
					</li>
				}
				<li>
					<span data-i18n="f.mcp.codex.auth_provider">Auth provider</span>
					<b>{ codexAuthProviderLabel(view.CodexState.AuthProvider) }</b>
				</li>
			</ul>
			if view.CodexState.AuthProvider == "unknown" {
				<p class="panel__help" data-i18n="f.mcp.codex.login_hint">Run <code class="key">codex login</code> to authenticate.</p>
			}
		} else {
			<p class="panel__help" data-i18n="f.mcp.codex.not_installed">codex is not installed.</p>
		}
		// Opt-in toggles (REQ-C-6 / AC-C-009): these write through the schema seam
		// to workflow.yaml at the exact path the fail-closed readers consume.
		@codexToggleRow("workflow.codex.review_gate.enabled", view.SchemaValues["workflow.codex.review_gate.enabled"] == "true")
		@codexToggleRow("workflow.codex.task.allow_write", view.SchemaValues["workflow.codex.task.allow_write"] == "true")
	</div>
}

// codexToggleRow renders one codex opt-in toggle using the same hidden-companion
// + segment pattern the MCP tool rows use, so parseSchemaForm + ApplySchemaEdits
// write it through the schema seam unchanged.
templ codexToggleRow(fieldName string, checked bool) {
	<div class="field">
		<div class="field__head">
			<span class="field__label" data-i18n={ "f." + fieldName + ".title" }>{ fieldName }</span>
		</div>
		<p class="field__help" data-i18n={ "f." + fieldName + ".desc" }></p>
		<div class="field__ctl">
			@boolSegment(fieldName, checked)
		</div>
	</div>
}

// mcpToolRow renders one MCP tool's enablement toggle plus, for write-capable
// tools, the text write-capable badge. checked defaults to true (all-enabled
// default per owner decision): an unset key reads as enabled, and only an
// explicit "false" value turns the toggle off.
templ mcpToolRow(f settings.FieldDef, checked bool) {
	<div class="field">
		<div class="field__head">
			<span class="field__label" data-i18n={ f.I18nKey + ".title" }>{ schemaFieldTitle(f) }</span>
			<code class="key">{ f.Name }</code>
			if mcpToolIsWriteCapable(f.Name) {
				<span class="badge badge--outline" data-i18n="f.mcp.write_capable.badge">Write-capable</span>
			}
		</div>
		<p class="field__help" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</p>
		<div class="field__ctl">
			@boolSegment(f.Name, checked)
		</div>
	</div>
}
