package web

import (
	"strconv"
	"strings"

	"github.com/modu-ai/moai-adk/internal/config"
	"github.com/modu-ai/moai-adk/internal/settings"
	"github.com/modu-ai/moai-adk/internal/settings/agentfm"
)

// sectionCount renders a section field-count label DERIVED from the schema
// length (SPEC-WEB-CONSOLE-011 B11 — no hardcoded "N fields" literals; the
// unit suffix is i18n-keyed so 4-locale rendering is preserved).
templ sectionCount(n int) {
	<span class="section__count">{ strconv.Itoa(n) } <span data-i18n="count.fields">field(s)</span></span>
}

// The fieldsets are typed Templ components taking the pageView; the Language
// fieldset reuses langSelect; Launch/Project reuse optSelect; permission_mode is
// rendered inline. Every empty-option label is single-sourced from the settings
// schema (settings.EmptyLabelFor) so the web and TUI render identical canonical
// labels per field. The Statusline section is NOT rendered here (M3 redesign) —
// the statusline schema + statusline.yaml remain consumed by the TUI /
// profile_setup CLI path.

// fieldsetIdentity ports the Identity fieldset (user_name text input, ~109-128).
templ fieldsetIdentity(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("user-round")</span><span data-i18n="sec.identity.title">Identity</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionIdentity)))
			</div>
			<p class="section__desc" data-i18n="sec.identity.desc">Who you are in commits and sessions.</p>
		</div>
		<div class="section__body">
			<div class="grid grid--1">
				<div class={ "field", templ.KV("has-error", hasFieldError(view.FieldErrors, "user_name")) }>
					<span class="field__label"><span class="field__title" data-i18n="f.user_name.title">Display name</span><code class="field__key">user_name</code></span>
					<span class="field__desc" data-i18n="f.user_name.desc">The name shown in commits and session headers.</span>
					if hasFieldError(view.FieldErrors, "user_name") {
						<input class="input" type="text" id="user_name" name="user_name" value={ view.Prefs.UserName } placeholder="e.g. jline" autocomplete="off" aria-invalid="true" aria-describedby="err_user_name"/>
						<span class="field-error" id="err_user_name">@icon("alert-circle")<span>{ fieldErrorMsg(view.FieldErrors, "user_name") }</span></span>
					} else {
						<input class="input" type="text" id="user_name" name="user_name" value={ view.Prefs.UserName } placeholder="e.g. jline" autocomplete="off"/>
					}
				</div>
			</div>
		</div>
	</fieldset>
}

// fieldsetLanguage ports the Language fieldset (4x langSelect, ~130-147).
templ fieldsetLanguage(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("languages")</span><span data-i18n="sec.language.title">Language</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionLanguage)))
			</div>
			<p class="section__desc" data-i18n="sec.language.desc">Languages used across conversation, commits, comments, and docs.</p>
		</div>
		<div class="section__body">
			<div class="grid">
				@langSelect(langSelectArgs{Name: "conversation_lang", Title: "Conversation language", Key: "conversation_lang", Desc: "Language the assistant replies in during chat.", Value: view.Prefs.ConversationLang, Options: view.LangOptions, Errors: view.FieldErrors})
				@langSelect(langSelectArgs{Name: "git_commit_lang", Title: "Commit message language", Key: "git_commit_lang", Desc: "Language used when writing git commit messages.", Value: view.Prefs.GitCommitLang, Options: view.LangOptions, Errors: view.FieldErrors})
				@langSelect(langSelectArgs{Name: "code_comment_lang", Title: "Code comment language", Key: "code_comment_lang", Desc: "Language for comments written into your code.", Value: view.Prefs.CodeCommentLang, Options: view.LangOptions, Errors: view.FieldErrors})
				@langSelect(langSelectArgs{Name: "doc_lang", Title: "Documentation language", Key: "doc_lang", Desc: "Language for generated docs and READMEs.", Value: view.Prefs.DocLang, Options: view.LangOptions, Errors: view.FieldErrors})
			</div>
		</div>
	</fieldset>
}

// fieldsetLaunch ports the Launch fieldset (~149-177): an inline permission_mode
// select (with the "(project default)" empty-option-when-blank logic) + 3x
// optSelect (model_policy / model / effort_level).
templ fieldsetLaunch(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("rocket")</span><span data-i18n="sec.launch.title">LLM</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionLaunch)))
			</div>
			<p class="section__desc" data-i18n="sec.launch.desc">How sessions start — permissions, model, and reasoning effort.</p>
		</div>
		<div class="section__body">
			<div class="grid">
				<div class={ "field", templ.KV("has-error", hasFieldError(view.FieldErrors, "permission_mode")) }>
					<span class="field__label"><span class="field__title" data-i18n="f.permission_mode.title">Permission mode</span><code class="field__key">permission_mode</code></span>
					<span class="field__desc" data-i18n="f.permission_mode.desc">How much the agent may do before asking you.</span>
					<span class="select-wrap">
						<select
							class="select"
							id="permission_mode"
							name="permission_mode"
							if hasFieldError(view.FieldErrors, "permission_mode") {
								aria-invalid="true"
								aria-describedby="err_permission_mode"
							}
						>
							for _, m := range view.PermissionModes {
								@permissionOption(m, view.Prefs.PermissionMode)
							}
						</select>
					</span>
					if msg := fieldErrorMsg(view.FieldErrors, "permission_mode"); msg != "" {
						<span class="field-error" id="err_permission_mode">@icon("alert-circle")<span>{ msg }</span></span>
					}
				</div>
				@optSelect(optSelectArgs{Name: "model_policy", Title: "Model policy", Key: "model_policy", Desc: "Quality vs. speed bias when a model is auto-selected.", Value: view.Prefs.ModelPolicy, Empty: settings.EmptyLabelFor("model_policy"), EmptyKey: settings.EmptyLabelKeyFor("model_policy"), Options: view.ModelPolicies, Errors: view.FieldErrors})
				@optSelect(optSelectArgs{Name: "model", Title: "Model", Key: "model", Desc: "The specific model to run, including 1M-context variants.", Value: view.Prefs.Model, Empty: settings.EmptyLabelFor("model"), EmptyKey: settings.EmptyLabelKeyFor("model"), Options: view.ModelOptions, Errors: view.FieldErrors})
				@optSelect(optSelectArgs{Name: "effort_level", Title: "Effort level", Key: "effort_level", Desc: "How much reasoning effort the model spends per task.", Value: view.Prefs.EffortLevel, Empty: settings.EmptyLabelFor("effort_level"), EmptyKey: settings.EmptyLabelKeyFor("effort_level"), Options: view.EffortLevels, Errors: view.FieldErrors})
				<div class="field">
					<span class="field__label"><span class="field__title" data-i18n="f.quality.quality_extras_enabled.title">Quality extras</span><code class="field__key">quality.quality_extras_enabled</code></span>
					<span class="field__desc" data-i18n="f.quality.quality_extras_enabled.desc">Enable the advanced quality-extras feature (DDD gates).</span>
					<label class="seg">
						<input type="hidden" name="quality.quality_extras_enabled__present" value="1"/>
						if view.SchemaValues["quality.quality_extras_enabled"] == "true" {
							<input type="checkbox" id="quality.quality_extras_enabled" name="quality.quality_extras_enabled" value="1" checked/>
						} else {
							<input type="checkbox" id="quality.quality_extras_enabled" name="quality.quality_extras_enabled" value="1"/>
						}
						<span class="seg__box"><span class="seg__tick">@icon("check")</span></span>
					</label>
				</div>
			</div>
		</div>
	</fieldset>
}

// permissionOption ports the permission_mode option rendering: an empty value
// renders "(project default)", otherwise the value itself; the current value is
// marked selected (page.html.tmpl ~165-167). M5-b D4: OptionDef 를 받아
// data-i18n 키를 방출한다. 빈 값은 opt.project_default 키를 쓴다.
templ permissionOption(opt settings.OptionDef, current string) {
	if opt.Value == current {
		if opt.Value == "" {
			<option value="" selected data-i18n="opt.project_default">(project default)</option>
		} else {
			<option value={ opt.Value } selected data-i18n={ opt.I18nKey }>{ opt.Value }</option>
		}
	} else {
		if opt.Value == "" {
			<option value="" data-i18n="opt.project_default">(project default)</option>
		} else {
			<option value={ opt.Value } data-i18n={ opt.I18nKey }>{ opt.Value }</option>
		}
	}
}

// SPEC-DESIGN-MOAIWEBV2-001 M1: fieldsetProject and its detectionField helper
// were removed (REQ-MWV2-020/021). The `project` tabpanel was unreachable (no
// navigable data-tab), so its render surface is deleted. The server-side parse
// seam (parseProjectNestedForm in projectconfig.go, wired in handlers.go) and the
// pageView.Cur* fields it consumes are PRESERVED (REQ-MWV2-031 zero server-contract
// change) — development_mode / git_convention / quality.* stay editable via yaml
// config files / CLI. Those view-model fields are now inert (seeded but not
// rendered); they are deliberately NOT pruned because handlers.go + its tests still
// reference them (deletion would cascade into the preserved server contract).

// ─── SPEC-WEB-CONSOLE-011 M2b: 10섹션 확장의 제네릭 스키마 fieldset ───────────
//
// 필드 라벨은 기술 식별자(key chip)로 렌더하며 data-i18n을 방출하지 않는다 —
// i18n.js 계약("Field identifiers stay in English as code chips and are NOT
// translated")과 정합. 섹션 title/desc와 공용 라벨(count.fields / ro.note /
// raw.note)만 i18n 키를 갖는다 (REQ-WC11-061 — 신규 prose 문자열 전부 4-locale).

// fieldsetSchemaSection은 확장 섹션 하나를 스키마 주도로 렌더한다: 편집 스칼라
// 필드(REQ-WC11-016) + read-only 표시 키(REQ-WC11-013/019) + collapsed raw view
// 서브블록(REQ-WC11-062).
templ fieldsetSchemaSection(view pageView, meta schemaSectionMeta) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon(meta.Icon)</span><span data-i18n={ "sec." + string(meta.ID) + ".title" }>{ meta.Title }</span></legend>
				@sectionCount(len(settings.SectionFields(meta.ID)))
			</div>
			<p class="section__desc" data-i18n={ "sec." + string(meta.ID) + ".desc" }>{ meta.Desc }</p>
		</div>
		<div class="section__body">
			<div class="grid">
				for _, f := range settings.SectionFields(meta.ID) {
					@schemaFieldWidget(view, f)
				}
				for _, ro := range settings.ReadOnlyDisplayFields() {
					if ro.Section == meta.ID {
						@schemaReadOnlyRow(ro.Name, view.SchemaValues[ro.Name], ro.NoteKey)
					}
				}
			</div>
			for _, rb := range settings.RawViewBlocks() {
				if rb.Section == meta.ID {
					@schemaRawBlock(rb.Name, view.RawBlocks[rb.Name], rb.NoteKey)
				}
			}
		</div>
	</fieldset>
}

// schemaFieldWidget은 FieldDef.Type에 따라 위젯을 선택한다.
templ schemaFieldWidget(view pageView, f settings.FieldDef) {
	switch f.Type {
		case settings.TypeBool:
			@schemaToggleRow(f, view.SchemaValues[f.Name] == "true")
		case settings.TypeSelect:
			@schemaSelectRow(f, view.SchemaValues[f.Name], view.FieldErrors)
		case settings.TypeRadio:
			@schemaRadioRow(f, view.SchemaValues[f.Name], view.FieldErrors)
		case settings.TypeInt:
			@schemaNumberRow(f, view.SchemaValues[f.Name], "1", view.FieldErrors)
		case settings.TypeFloat:
			@schemaNumberRow(f, view.SchemaValues[f.Name], "0.01", view.FieldErrors)
		default:
			@schemaTextRow(f, view.SchemaValues[f.Name], view.FieldErrors)
	}
}

// fieldDescription renders the REQ-WC-015 field-level description (design.md §H.1
// option (a)): a muted helper paragraph below the label, resolved client-side from
// the FieldDef.Description i18n key (fieldDesc.<sectionID>.<fieldID> convention).
// Empty Description = no description rendered. SPEC-WEBCONF-SIMPLIFY-001 M4.
templ fieldDescription(f settings.FieldDef) {
	if f.Description != "" {
		<p class="field-description" data-i18n={ f.Description }></p>
	}
}

// schemaTextRow — 자유 텍스트. EmptyLabel이 있으면 placeholder로 렌더한다
// (빈 값의 "(runtime default)" 시맨틱 — REQ-WC11-014/EC-4. M4 다이어트로
// claude_models tier는 제거되었고, EmptyLabel 메커니즘은 generic placeholder로
// 잔류한다.) M5-b D3: field__title + field__desc data-i18n 훅 추가 (key chip 은
// data-i18n 없이 영문 코드 토큰 유지).
templ schemaTextRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class={ "field", templ.KV("has-error", hasFieldError(errs, f.Name)) }>
		<span class="field__label"><span class="field__title" data-i18n={ f.I18nKey + ".title" }>{ schemaFieldTitle(f) }</span><code class="field__key">{ f.Name }</code></span>
		<span class="field__desc" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</span>
		<input class="input" type="text" id={ f.Name } name={ f.Name } value={ value } placeholder={ f.EmptyLabel } autocomplete="off"/>
		if msg := fieldErrorMsg(errs, f.Name); msg != "" {
			<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
		}
	</div>
}

// schemaNumberRow — 정수/실수 입력. M5-b D3: field__title + field__desc 추가.
templ schemaNumberRow(f settings.FieldDef, value, step string, errs map[string]string) {
	<div class={ "field", templ.KV("has-error", hasFieldError(errs, f.Name)) }>
		<span class="field__label"><span class="field__title" data-i18n={ f.I18nKey + ".title" }>{ schemaFieldTitle(f) }</span><code class="field__key">{ f.Name }</code></span>
		<span class="field__desc" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</span>
		<input class="input" type="number" id={ f.Name } name={ f.Name } value={ value } step={ step } autocomplete="off"/>
		if msg := fieldErrorMsg(errs, f.Name); msg != "" {
			<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
		}
	</div>
}

// schemaToggleRow — bool 토글. hidden __present companion으로 "unchecked →
// false"와 "미제출 → preserve"를 구분한다 (동일한 disambiguation 패턴).
// M5-b D3: field__title + field__desc 추가.
templ schemaToggleRow(f settings.FieldDef, checked bool) {
	<div class="field">
		<span class="field__label"><span class="field__title" data-i18n={ f.I18nKey + ".title" }>{ schemaFieldTitle(f) }</span><code class="field__key">{ f.Name }</code></span>
		<span class="field__desc" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</span>
		<label class="seg">
			<input type="hidden" name={ f.Name + "__present" } value="1"/>
			if checked {
				<input type="checkbox" id={ f.Name } name={ f.Name } value="1" checked/>
			} else {
				<input type="checkbox" id={ f.Name } name={ f.Name } value="1"/>
			}
			<span class="seg__box"><span class="seg__tick">@icon("check")</span></span>
		</label>
		@fieldDescription(f)
	</div>
}

// schemaSelectRow — 닫힌 옵션 select. EmptyLabel이 있으면 빈 옵션을 렌더한다.
// effort 필드에는 declarative 배지를 표시한다 — Go 런타임이 행동적으로 바인딩하지
// 않는 선언적 힌트임을 사용자에게 알린다 (M5-a B5). M5-b D3: field__title +
// field__desc 추가. baseline 텍스트는 영어다: 하드코딩된 한국어는 JS 미실행 렌더에서
// 모든 로케일에 한국어를 노출했다.
templ schemaSelectRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class={ "field", templ.KV("has-error", hasFieldError(errs, f.Name)) }>
		<span class="field__label">
			<span class="field__title" data-i18n={ f.I18nKey + ".title" }>{ schemaFieldTitle(f) }</span>
			<code class="field__key">{ f.Name }</code>
			if strings.HasSuffix(f.Name, ".effort") {
				<span class="field__hint" data-i18n="hint.effort.go_unbound">(declarative — not read by the runtime)</span>
			}
		</span>
		<span class="field__desc" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</span>
		<span class="select-wrap">
			<select class="select" id={ f.Name } name={ f.Name }>
				if f.EmptyLabel != "" {
					if value == "" {
						<option value="" selected data-i18n={ f.EmptyLabelKey }>{ f.EmptyLabel }</option>
					} else {
						<option value="" data-i18n={ f.EmptyLabelKey }>{ f.EmptyLabel }</option>
					}
				}
				for _, opt := range f.Options {
					if opt.Value == value {
						<option value={ opt.Value } selected data-i18n={ opt.I18nKey } data-i18n-title={ f.Description + ".option." + opt.Value }>{ opt.Value }</option>
					} else {
						<option value={ opt.Value } data-i18n={ opt.I18nKey } data-i18n-title={ f.Description + ".option." + opt.Value }>{ opt.Value }</option>
					}
				}
			</select>
		</span>
		@fieldDescription(f)
		if msg := fieldErrorMsg(errs, f.Name); msg != "" {
			<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
		}
	</div>
}

// schemaRadioRow — 닫힌 옵션 라디오 버튼 그룹. EmptyLabel이 있으면 빈 옵션을 렌더한다.
// M5-b D3: field__title + field__desc 추가.
templ schemaRadioRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class={ "field", templ.KV("has-error", hasFieldError(errs, f.Name)) }>
		<span class="field__label">
			<span class="field__title" data-i18n={ f.I18nKey + ".title" }>{ schemaFieldTitle(f) }</span>
			<code class="field__key">{ f.Name }</code>
		</span>
		<span class="field__desc" data-i18n={ f.I18nKey + ".desc" }>{ schemaFieldDesc(f) }</span>
		<div class="radio-group">
			if f.EmptyLabel != "" {
				<label class="radio">
					if value == "" {
						<input type="radio" id={ f.Name + "--empty" } name={ f.Name } value="" checked/>
					} else {
						<input type="radio" id={ f.Name + "--empty" } name={ f.Name } value=""/>
					}
					<span class="radio__box"><span class="radio__tick">@icon("check")</span></span>
					<span data-i18n={ f.EmptyLabelKey }>{ f.EmptyLabel }</span>
				</label>
			}
			for _, opt := range f.Options {
				<label class="radio">
					if opt.Value == value {
						<input type="radio" id={ f.Name + "--" + opt.Value } name={ f.Name } value={ opt.Value } checked/>
					} else {
						<input type="radio" id={ f.Name + "--" + opt.Value } name={ f.Name } value={ opt.Value }/>
					}
					<span class="radio__box"><span class="radio__tick">@icon("check")</span></span>
					<span data-i18n={ opt.I18nKey } data-i18n-title={ f.Description + ".option." + opt.Value }>{ opt.Value }</span>
				</label>
			}
		</div>
		@fieldDescription(f)
		if msg := fieldErrorMsg(errs, f.Name); msg != "" {
			<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
		}
	</div>
}

// schemaReadOnlyRow — read-only 표시 키 (REQ-WC11-013/019). form 컨트롤을 일절
// 렌더하지 않으므로 제출 자체가 불가능하다 — 파일 값 불변이 구조적으로 보장.
// noteKey가 비어 있으면 제네릭 "ro.note"를, 아니면 정직한 설명 라벨 키를 방출한다
// (SPEC-WEB-CONSOLE-014 M2 — governance FROZEN / dead-config 강등, REQ-WC14-001/040).
templ schemaReadOnlyRow(name, value, noteKey string) {
	<div class="field field--readonly">
		<span class="field__label"><code class="field__key">{ name }</code><span class="field__ro" data-i18n={ roNoteKey(noteKey) }>{ roNoteBaseline(noteKey) }</span></span>
		<span class="input input--ro">{ value }</span>
	</div>
}

// schemaRawBlock — form UI에 맞지 않는 map/list 서브블록의 collapsed raw view
// (REQ-WC11-062). input 컨트롤 0 — <pre> 텍스트 표시만. noteKey가 비어 있으면
// 제네릭 "raw.note"를, 아니면 정보성 정직 라벨 키를 방출한다 (SPEC-WEB-CONSOLE-014
// — enforcement 컴파일 상수 / config-미배선 scaffold, REQ-WC14-003/020).
templ schemaRawBlock(name, content, noteKey string) {
	<details class="rawview">
		<summary><code class="field__key">{ name }</code> <span data-i18n={ rawNoteKey(noteKey) }>{ rawNoteBaseline(noteKey) }</span></summary>
		<pre class="rawview__pre">{ content }</pre>
	</details>
}

// ─── SPEC-WEB-CONSOLE-011 M3: sub-agent frontmatter 편집 카드 ────────────────
//
// 4표면 agent-settings 뷰의 (c) 표면 (REQ-WC11-020/025/027..029). (a) llm tiers는
// LLM 섹션에서 편집(교차 참조 노트), (b) role_profiles + (d) workflow_agents는
// 제네릭 Agent Settings fieldset(SectionAgentSettings)이 렌더한다.

// fieldsetAgentFrontmatter는 .claude/agents/moai/ sub-agent의 model/effort
// frontmatter 편집 표를 렌더한다. 지속 경고("moai update가 덮어쓸 수 있음",
// REQ-WC11-028) + llm 교차 참조 + dynamic-workflows taxonomy 참조(REQ-WC11-026)를
// 포함한다. effort의 "(absent)" 옵션은 키 삭제를 의미한다 (EC-7).
//
// 구 "하네스 에이전트" sub-tab은 제거됐다: harness 행은 렌더하지 않는다. 스캔
// 자체는 그대로라 미렌더 agent는 폼 값을 제출하지 않고, parseAgentFMForm이 이를
// "preserve"로 읽으므로 harness frontmatter는 기록되지 않는다.
templ fieldsetAgentFrontmatter(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("user-round")</span><span data-i18n="sec.agentfm.title">Agents</span></legend>
				@sectionCount(agentFMRenderCount(view.AgentFMs))
			</div>
			<p class="section__desc" data-i18n="sec.agentfm.desc">Per-agent model/effort frontmatter of the live agent files (frontmatter-only writes; bodies untouched).</p>
			<p class="section__desc agentfm-warn">@icon("alert-circle") <span data-i18n="agentfm.warn">These files are template-managed — a later `moai update` may overwrite live edits.</span></p>
			<p class="section__desc"><span data-i18n="agentfm.llmnote">LLM tier mappings are edited in the LLM section above.</span></p>
			<p class="section__desc"><span data-i18n="agentfm.taxonomy">workflow_agents purpose defaults follow the purpose taxonomy in</span> <code class="field__key">.claude/rules/moai/workflow/dynamic-workflows.md</code></p>
		</div>
		<div class="section__body">
			<div class="grid">
				<div class={ "field", templ.KV("has-error", hasFieldError(view.FieldErrors, "performance_tier")) }>
					<span class="field__label"><span class="field__title" data-i18n="agentfm.tier.title">Performance tier</span><code class="field__key">llm.performance_tier</code></span>
					<span class="field__desc" data-i18n="agentfm.tier.desc">Model/effort tier column applied to the shipped agents (max / medium / low). Switching re-applies the matching tier profile to every shipped agent definition file.</span>
					<div class="radio-group">
						for _, opt := range agentFMPerfTierOptions() {
							<label class="radio">
								if !view.PerfTierCustom && (opt == view.PerfTier || (view.PerfTierIsEmpty && opt == "medium")) {
									<input type="radio" id={ "performance_tier--" + opt } name="performance_tier" value={ opt } checked/>
								} else {
									<input type="radio" id={ "performance_tier--" + opt } name="performance_tier" value={ opt }/>
								}
								<span class="radio__box"><span class="radio__tick">@icon("check")</span></span>
								<span>{ opt }</span>
							</label>
						}
						<label class="radio">
							if view.PerfTierCustom {
								<input type="radio" id="performance_tier--custom" name="performance_tier" value="custom" checked/>
							} else {
								<input type="radio" id="performance_tier--custom" name="performance_tier" value="custom"/>
							}
							<span class="radio__box"><span class="radio__tick">@icon("check")</span></span>
							<span data-i18n="agentfm.tier.custom">Custom</span>
						</label>
					</div>
					if view.PerfTierIsEmpty {
						<span class="field__hint" data-i18n="agentfm.tier.default">(runtime default: medium)</span>
					}
					if msg := fieldErrorMsg(view.FieldErrors, "performance_tier"); msg != "" {
						<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
					}
				</div>
			</div>
			@templ.JSONScript("moai-profile-matrix", profileMatrixData())
			<div class="grid">
				for _, agent := range view.AgentFMs {
					if agentIsMoaiCore(agent) {
						@agentFMRow(agent, view.LLM, view.FieldErrors)
					}
				}
			</div>
		</div>
	</fieldset>
}

// agentFMRow는 agent 1종의 model/effort select 쌍이다. 빈 옵션 = 현재값 유지
// (empty=preserve). 파싱 실패 행은 편집 비활성 표시만 한다 (design.md §C.1).
templ agentFMRow(agent agentfm.AgentInfo, llm config.LLMConfig, errs map[string]string) {
	if agent.ParseOK {
		<div class="field">
			<span class="field__label">
				if agentTierBadge(agent.Name, agent.Model, agent.Effort).HasBadge {
					<span class={ "agentfm-badge", templ.KV("agentfm-badge--custom", agentTierBadge(agent.Name, agent.Model, agent.Effort).IsCustom) } data-i18n-title={ agentTierBadge(agent.Name, agent.Model, agent.Effort).TooltipKey }>{ agentTierBadge(agent.Name, agent.Model, agent.Effort).Glyph }</span>
				}
				<code class="field__key agentfm-name">{ agent.Name }</code>
			</span>
			if short := agentDescriptionShort(agent.Description); short != "" {
				<span class="agentfm-desc">{ short }</span>
			}
			<span class="select-wrap">
				<select class="select" name={ "agentfm." + agent.Name + ".model" } id={ "agentfm." + agent.Name + ".model" }>
					for _, m := range agentFMModelValues() {
						if m == agentSelectedModel(llm, agent) {
							<option value={ m } selected data-i18n-title={ "fieldDesc.agentfm.model." + m }>{ m }</option>
						} else {
							<option value={ m } data-i18n-title={ "fieldDesc.agentfm.model." + m }>{ m }</option>
						}
					}
				</select>
			</span>
			if agentModelIsDefault(llm, agent) {
				<span class="field__hint agentfm-default-tag" data-i18n="agentfm.default">(default)</span>
			}
			<span class="select-wrap">
				<select class="select" name={ "agentfm." + agent.Name + ".effort" } id={ "agentfm." + agent.Name + ".effort" }>
					for _, e := range agentFMEffortValues() {
						if e == agentSelectedEffort(llm, agent) {
							<option value={ e } selected data-i18n-title={ "fieldDesc.agentfm.effort." + e }>{ e }</option>
						} else {
							<option value={ e } data-i18n-title={ "fieldDesc.agentfm.effort." + e }>{ e }</option>
						}
					}
				</select>
			</span>
			if agentEffortIsDefault(llm, agent) {
				<span class="field__hint agentfm-default-tag" data-i18n="agentfm.default">(default)</span>
			}
			<span class="field__hint" data-i18n="hint.effort.go_unbound">(declarative — not read by the runtime)</span>
			if msg := fieldErrorMsg(errs, "agentfm."+agent.Name+".model"); msg != "" {
				<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
			}
			if msg := fieldErrorMsg(errs, "agentfm."+agent.Name+".effort"); msg != "" {
				<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
			}
		</div>
	} else {
		<div class="field field--readonly">
			<span class="field__label"><code class="field__key">{ agent.Name }</code><span class="field__ro" data-i18n="agentfm.unavailable">unavailable (frontmatter parse failed)</span></span>
		</div>
	}
}
