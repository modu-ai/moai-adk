package web

import (
	"strconv"

	"github.com/modu-ai/moai-adk/internal/settings"
)

// sectionCount renders a section field-count label DERIVED from the schema
// length (SPEC-WEB-CONSOLE-011 B11 — no hardcoded "N fields" literals; the
// unit suffix is i18n-keyed so 4-locale rendering is preserved).
templ sectionCount(n int) {
	<span class="section__count">{ strconv.Itoa(n) } <span data-i18n="count.fields">field(s)</span></span>
}

// The fieldsets are typed Templ components taking the pageView; the Language
// fieldset reuses langSelect; Launch/Project reuse optSelect; permission_mode is
// rendered inline. SPEC-WEB-CONSOLE-010 re-added fieldsetStatusline (theme + 15
// segments, NO preset) and single-sourced every empty-option label from the
// settings schema (settings.EmptyLabelFor) so the web and TUI render identical
// canonical labels per field.

// fieldsetIdentity ports the Identity fieldset (user_name text input, ~109-128).
templ fieldsetIdentity(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("user-round")</span><span data-i18n="sec.identity.title">Identity</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionIdentity)))
			</div>
			<p class="section__desc" data-i18n="sec.identity.desc">Who you are in commits and sessions.</p>
		</div>
		<div class="section__body">
			<div class="grid grid--1">
				<div class={ "field", templ.KV("has-error", hasFieldError(view.FieldErrors, "user_name")) }>
					<span class="field__label"><span class="field__title" data-i18n="f.user_name.title">Display name</span><code class="field__key">user_name</code></span>
					<span class="field__desc" data-i18n="f.user_name.desc">The name shown in commits and session headers.</span>
					if hasFieldError(view.FieldErrors, "user_name") {
						<input class="input" type="text" id="user_name" name="user_name" value={ view.Prefs.UserName } placeholder="e.g. jline" autocomplete="off" aria-invalid="true" aria-describedby="err_user_name"/>
						<span class="field-error" id="err_user_name">@icon("alert-circle")<span>{ fieldErrorMsg(view.FieldErrors, "user_name") }</span></span>
					} else {
						<input class="input" type="text" id="user_name" name="user_name" value={ view.Prefs.UserName } placeholder="e.g. jline" autocomplete="off"/>
					}
				</div>
			</div>
		</div>
	</fieldset>
}

// fieldsetLanguage ports the Language fieldset (4x langSelect, ~130-147).
templ fieldsetLanguage(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("languages")</span><span data-i18n="sec.language.title">Language</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionLanguage)))
			</div>
			<p class="section__desc" data-i18n="sec.language.desc">Languages used across conversation, commits, comments, and docs.</p>
		</div>
		<div class="section__body">
			<div class="grid">
				@langSelect(langSelectArgs{Name: "conversation_lang", Title: "Conversation language", Key: "conversation_lang", Desc: "Language the assistant replies in during chat.", Value: view.Prefs.ConversationLang, Options: view.LangOptions, Errors: view.FieldErrors})
				@langSelect(langSelectArgs{Name: "git_commit_lang", Title: "Commit message language", Key: "git_commit_lang", Desc: "Language used when writing git commit messages.", Value: view.Prefs.GitCommitLang, Options: view.LangOptions, Errors: view.FieldErrors})
				@langSelect(langSelectArgs{Name: "code_comment_lang", Title: "Code comment language", Key: "code_comment_lang", Desc: "Language for comments written into your code.", Value: view.Prefs.CodeCommentLang, Options: view.LangOptions, Errors: view.FieldErrors})
				@langSelect(langSelectArgs{Name: "doc_lang", Title: "Documentation language", Key: "doc_lang", Desc: "Language for generated docs and READMEs.", Value: view.Prefs.DocLang, Options: view.LangOptions, Errors: view.FieldErrors})
			</div>
		</div>
	</fieldset>
}

// fieldsetLaunch ports the Launch fieldset (~149-177): an inline permission_mode
// select (with the "(project default)" empty-option-when-blank logic) + 3x
// optSelect (model_policy / model / effort_level).
templ fieldsetLaunch(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("rocket")</span><span data-i18n="sec.launch.title">Launch</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionLaunch)))
			</div>
			<p class="section__desc" data-i18n="sec.launch.desc">How sessions start — permissions, model, and reasoning effort.</p>
		</div>
		<div class="section__body">
			<div class="grid">
				<div class={ "field", templ.KV("has-error", hasFieldError(view.FieldErrors, "permission_mode")) }>
					<span class="field__label"><span class="field__title" data-i18n="f.permission_mode.title">Permission mode</span><code class="field__key">permission_mode</code></span>
					<span class="field__desc" data-i18n="f.permission_mode.desc">How much the agent may do before asking you.</span>
					<span class="select-wrap">
						<select
							class="select"
							id="permission_mode"
							name="permission_mode"
							if hasFieldError(view.FieldErrors, "permission_mode") {
								aria-invalid="true"
								aria-describedby="err_permission_mode"
							}
						>
							for _, m := range view.PermissionModes {
								@permissionOption(m, view.Prefs.PermissionMode)
							}
						</select>
					</span>
					if msg := fieldErrorMsg(view.FieldErrors, "permission_mode"); msg != "" {
						<span class="field-error" id="err_permission_mode">@icon("alert-circle")<span>{ msg }</span></span>
					}
				</div>
				@optSelect(optSelectArgs{Name: "model_policy", Title: "Model policy", Key: "model_policy", Desc: "Quality vs. speed bias when a model is auto-selected.", Value: view.Prefs.ModelPolicy, Empty: settings.EmptyLabelFor("model_policy"), Options: view.ModelPolicies, Errors: view.FieldErrors})
				@optSelect(optSelectArgs{Name: "model", Title: "Model", Key: "model", Desc: "The specific model to run, including 1M-context variants.", Value: view.Prefs.Model, Empty: settings.EmptyLabelFor("model"), Options: view.ModelOptions, Errors: view.FieldErrors})
				@optSelect(optSelectArgs{Name: "effort_level", Title: "Effort level", Key: "effort_level", Desc: "How much reasoning effort the model spends per task.", Value: view.Prefs.EffortLevel, Empty: settings.EmptyLabelFor("effort_level"), Options: view.EffortLevels, Errors: view.FieldErrors})
			</div>
		</div>
	</fieldset>
}

// permissionOption ports the permission_mode option rendering: an empty value
// renders "(project default)", otherwise the value itself; the current value is
// marked selected (page.html.tmpl ~165-167).
templ permissionOption(value, current string) {
	if value == current {
		if value == "" {
			<option value="" selected>(project default)</option>
		} else {
			<option value={ value } selected>{ value }</option>
		}
	} else {
		if value == "" {
			<option value="">(project default)</option>
		} else {
			<option value={ value }>{ value }</option>
		}
	}
}

// fieldsetStatusline re-adds the Statusline section to the web console
// (SPEC-WEB-CONSOLE-010 REQ-WC10-009): a theme <select> + 15 segment toggles
// sourced from the shared schema. The retired statusline `preset` selector is NOT
// reintroduced (REQ-WC10-010) — there is no preset form control, option list, or
// validation rule. The segment toggles reuse the segmentToggle helper (checkbox +
// hidden __present companion) so the segment map round-trips with the
// empty=preserve semantic at the config layer (syncStatusline).
templ fieldsetStatusline(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("panel-bottom")</span><span data-i18n="sec.statusline.title">Statusline</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionStatusline)))
			</div>
			<p class="section__desc" data-i18n="sec.statusline.desc">The status bar shown at the bottom of your terminal.</p>
		</div>
		<div class="section__body">
			<div class="grid grid--1">
				<div class={ "field", templ.KV("has-error", hasFieldError(view.FieldErrors, "statusline_theme")) }>
					<span class="field__label"><span class="field__title" data-i18n="f.statusline_theme.title">Statusline theme</span><code class="field__key">statusline_theme</code></span>
					<span class="field__desc" data-i18n="f.statusline_theme.desc">Color theme for the status bar.</span>
					<span class="select-wrap">
						<select
							class="select"
							id="statusline_theme"
							name="statusline_theme"
							if hasFieldError(view.FieldErrors, "statusline_theme") {
								aria-invalid="true"
							}
						>
							for _, theme := range view.StatuslineThemes {
								if theme == view.Prefs.StatuslineTheme {
									<option value={ theme } selected>{ theme }</option>
								} else {
									<option value={ theme }>{ theme }</option>
								}
							}
						</select>
					</span>
					if msg := fieldErrorMsg(view.FieldErrors, "statusline_theme"); msg != "" {
						<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
					}
				</div>
			</div>
			<div class="grid">
				for _, seg := range view.StatuslineSegs {
					@segmentToggle(seg, view.Prefs.StatuslineSegments[seg])
				}
			</div>
		</div>
	</fieldset>
}

// segmentToggle renders one statusline segment as a checkbox toggle
// (SPEC-WEB-CONSOLE-010). The control name is seg_<key> with a hidden companion
// seg_<key>__present so the server can distinguish "unchecked" (companion present,
// checkbox absent → false) from "section not submitted" (companion absent →
// preserve). The data-i18n key is seg.<key> — the 15 per-segment labels authored in
// i18n.js. The segment KEY is shown as a code chip so the row is identifiable even
// before i18n applies. NO preset control is rendered (REQ-WC10-010).
templ segmentToggle(seg string, checked bool) {
	<div class="field">
		<span class="field__label"><span class="field__title" data-i18n={ "seg." + seg }>{ seg }</span><code class="field__key">{ seg }</code></span>
		<label class="seg">
			<input type="hidden" name={ "seg_" + seg + "__present" } value="1"/>
			if checked {
				<input type="checkbox" id={ "seg_" + seg } name={ "seg_" + seg } value="1" checked/>
			} else {
				<input type="checkbox" id={ "seg_" + seg } name={ "seg_" + seg } value="1"/>
			}
			<span class="seg__box"><span class="seg__tick">@icon("check")</span></span>
		</label>
	</div>
}

// fieldsetProject ports the Project fieldset and extends it with the curated
// nested config fields (REQ-WC9-010). The two optSelect scalars (development_mode /
// git_convention) keep their shape; the git_convention nested fields model the live
// levers only — confidence_threshold, the auto-detect toggle, sample_size, and the
// enforce_on_push gate. The custom.pattern widget is removed (the custom engine is
// gone). The three auto-detection sub-fields carry a client de-emphasis hint when
// the selected convention is not "auto" (REQ-WC9-012; no server cross-field logic).
// The section count label derives from the schema length (B11 derived count).
templ fieldsetProject(view pageView) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon("folder-git")</span><span data-i18n="sec.project.title">Project</span></legend>
				@sectionCount(len(settings.SectionFields(settings.SectionQuality)) + len(settings.SectionFields(settings.SectionGitConvention)))
			</div>
			<p class="section__desc" data-i18n="sec.project.desc">Project-level development and git conventions.</p>
		</div>
		<div class="section__body">
			<div class="grid" data-convention={ view.CurConvention }>
				@optSelect(optSelectArgs{Name: "development_mode", Title: "Development mode", Key: "development_mode", Desc: "Default workflow — domain-driven (DDD) or test-driven (TDD).", Value: view.CurDevelopmentMode, Empty: settings.EmptyLabelFor("development_mode"), Options: view.DevelopmentModes, Errors: view.FieldErrors})
				@optSelect(optSelectArgs{Name: "git_convention", Title: "Git convention", Key: "git_convention", Desc: "Commit message convention enforced in this project.", Value: view.CurConvention, Empty: settings.EmptyLabelFor("git_convention"), Options: view.Conventions, Errors: view.FieldErrors})
				@numberField(numberFieldArgs{Name: "quality.test_coverage_target", Title: "Test coverage target", Key: "quality.test_coverage_target", Desc: "Minimum overall test coverage percentage (0-100).", Value: view.CurTestCoverageTarget, Min: "0", Max: "100", Step: "1", Errors: view.FieldErrors})
				@toggle(toggleArgs{Name: "quality.enforce_quality", Title: "Enforce quality gate", Key: "quality.enforce_quality", Desc: "Block on TRUST 5 quality-gate failures.", Checked: view.CurEnforceQuality, Errors: view.FieldErrors})
				@numberField(numberFieldArgs{Name: "quality.tdd_settings.min_coverage_per_commit", Title: "Min coverage per commit", Key: "quality.tdd_settings.min_coverage_per_commit", Desc: "Minimum coverage required per commit in TDD mode (0-100).", Value: view.CurMinCoveragePerCommit, Min: "0", Max: "100", Step: "1", Errors: view.FieldErrors})
				@detectionField(view.CurConvention, numberField(numberFieldArgs{Name: "git_convention.auto_detection.confidence_threshold", Title: "Detection confidence threshold", Key: "git_convention.auto_detection.confidence_threshold", Desc: "Confidence required to auto-detect a convention (0.0-1.0).", Value: view.CurConfidenceThreshold, Min: "0", Max: "1", Step: "0.01", Errors: view.FieldErrors}))
				@detectionField(view.CurConvention, numberField(numberFieldArgs{Name: "git_convention.auto_detection.sample_size", Title: "Detection sample size", Key: "git_convention.auto_detection.sample_size", Desc: "Number of recent commits analyzed during auto-detection.", Value: view.CurSampleSize, Min: "0", Step: "1", Errors: view.FieldErrors}))
				@detectionField(view.CurConvention, toggle(toggleArgs{Name: "git_convention.auto_detection.enabled", Title: "Auto-detect convention", Key: "git_convention.auto_detection.enabled", Desc: "Auto-detect the commit convention from history.", Checked: view.CurAutoDetectionEnabled, Errors: view.FieldErrors}))
				@toggle(toggleArgs{Name: "git_convention.validation.enforce_on_push", Title: "Enforce on push", Key: "git_convention.validation.enforce_on_push", Desc: "Reject a push when a commit message violates the convention.", Checked: view.CurEnforceOnPush, Errors: view.FieldErrors})
			</div>
		</div>
	</fieldset>
}

// detectionField wraps an auto-detection sub-field widget in a div that carries a
// de-emphasis class when the selected convention is not "auto" (REQ-WC9-012). This
// is a CLIENT hint only — the server applies no cross-field logic and the wrapped
// widget stays fully submittable. When convention is "auto" (or unset → preserve)
// the sub-field renders active; otherwise it renders greyed via the
// detection-subfield--inactive modifier.
templ detectionField(convention string, widget templ.Component) {
	if convention == "auto" || convention == "" {
		<div class="detection-subfield">
			@widget
		</div>
	} else {
		<div class="detection-subfield detection-subfield--inactive" aria-disabled="true">
			@widget
		</div>
	}
}

// ─── SPEC-WEB-CONSOLE-011 M2b: 10섹션 확장의 제네릭 스키마 fieldset ───────────
//
// 필드 라벨은 기술 식별자(key chip)로 렌더하며 data-i18n을 방출하지 않는다 —
// i18n.js 계약("Field identifiers stay in English as code chips and are NOT
// translated")과 정합. 섹션 title/desc와 공용 라벨(count.fields / ro.note /
// raw.note)만 i18n 키를 갖는다 (REQ-WC11-061 — 신규 prose 문자열 전부 4-locale).

// fieldsetSchemaSection은 확장 섹션 하나를 스키마 주도로 렌더한다: 편집 스칼라
// 필드(REQ-WC11-016) + read-only 표시 키(REQ-WC11-013/019) + collapsed raw view
// 서브블록(REQ-WC11-062).
templ fieldsetSchemaSection(view pageView, meta schemaSectionMeta) {
	<fieldset class="section">
		<div class="section__head">
			<div class="section__head-row">
				<legend class="section__legend"><span class="section__ico">@icon(meta.Icon)</span><span data-i18n={ "sec." + string(meta.ID) + ".title" }>{ meta.Title }</span></legend>
				@sectionCount(len(settings.SectionFields(meta.ID)))
			</div>
			<p class="section__desc" data-i18n={ "sec." + string(meta.ID) + ".desc" }>{ meta.Desc }</p>
		</div>
		<div class="section__body">
			<div class="grid">
				for _, f := range settings.SectionFields(meta.ID) {
					@schemaFieldWidget(view, f)
				}
				for _, ro := range settings.ReadOnlyDisplayFields() {
					if ro.Section == meta.ID {
						@schemaReadOnlyRow(ro.Name, view.SchemaValues[ro.Name])
					}
				}
			</div>
			for _, rb := range settings.RawViewBlocks() {
				if rb.Section == meta.ID {
					@schemaRawBlock(rb.Name, view.RawBlocks[rb.Name])
				}
			}
		</div>
	</fieldset>
}

// schemaFieldWidget은 FieldDef.Type에 따라 위젯을 선택한다.
templ schemaFieldWidget(view pageView, f settings.FieldDef) {
	switch f.Type {
		case settings.TypeBool:
			@schemaToggleRow(f.Name, view.SchemaValues[f.Name] == "true")
		case settings.TypeSelect:
			@schemaSelectRow(f, view.SchemaValues[f.Name], view.FieldErrors)
		case settings.TypeInt:
			@schemaNumberRow(f.Name, view.SchemaValues[f.Name], "1", view.FieldErrors)
		case settings.TypeFloat:
			@schemaNumberRow(f.Name, view.SchemaValues[f.Name], "0.01", view.FieldErrors)
		default:
			@schemaTextRow(f, view.SchemaValues[f.Name], view.FieldErrors)
	}
}

// schemaTextRow — 자유 텍스트. EmptyLabel이 있으면 placeholder로 렌더한다
// (빈 claude_models tier의 "(runtime default)" 시맨틱, REQ-WC11-014/EC-4).
templ schemaTextRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class={ "field", templ.KV("has-error", hasFieldError(errs, f.Name)) }>
		<span class="field__label"><code class="field__key">{ f.Name }</code></span>
		<input class="input" type="text" id={ f.Name } name={ f.Name } value={ value } placeholder={ f.EmptyLabel } autocomplete="off"/>
		if msg := fieldErrorMsg(errs, f.Name); msg != "" {
			<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
		}
	</div>
}

// schemaNumberRow — 정수/실수 입력.
templ schemaNumberRow(name, value, step string, errs map[string]string) {
	<div class={ "field", templ.KV("has-error", hasFieldError(errs, name)) }>
		<span class="field__label"><code class="field__key">{ name }</code></span>
		<input class="input" type="number" id={ name } name={ name } value={ value } step={ step } autocomplete="off"/>
		if msg := fieldErrorMsg(errs, name); msg != "" {
			<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
		}
	</div>
}

// schemaToggleRow — bool 토글. hidden __present companion으로 "unchecked →
// false"와 "미제출 → preserve"를 구분한다 (segmentToggle 선례).
templ schemaToggleRow(name string, checked bool) {
	<div class="field">
		<span class="field__label"><code class="field__key">{ name }</code></span>
		<label class="seg">
			<input type="hidden" name={ name + "__present" } value="1"/>
			if checked {
				<input type="checkbox" id={ name } name={ name } value="1" checked/>
			} else {
				<input type="checkbox" id={ name } name={ name } value="1"/>
			}
			<span class="seg__box"><span class="seg__tick">@icon("check")</span></span>
		</label>
	</div>
}

// schemaSelectRow — 닫힌 옵션 select. EmptyLabel이 있으면 빈 옵션을 렌더한다.
templ schemaSelectRow(f settings.FieldDef, value string, errs map[string]string) {
	<div class={ "field", templ.KV("has-error", hasFieldError(errs, f.Name)) }>
		<span class="field__label"><code class="field__key">{ f.Name }</code></span>
		<span class="select-wrap">
			<select class="select" id={ f.Name } name={ f.Name }>
				if f.EmptyLabel != "" {
					if value == "" {
						<option value="" selected>{ f.EmptyLabel }</option>
					} else {
						<option value="">{ f.EmptyLabel }</option>
					}
				}
				for _, opt := range f.SelectOptions() {
					if opt == value {
						<option value={ opt } selected>{ opt }</option>
					} else {
						<option value={ opt }>{ opt }</option>
					}
				}
			</select>
		</span>
		if msg := fieldErrorMsg(errs, f.Name); msg != "" {
			<span class="field-error">@icon("alert-circle")<span>{ msg }</span></span>
		}
	</div>
}

// schemaReadOnlyRow — read-only 표시 키 (REQ-WC11-013/019). form 컨트롤을 일절
// 렌더하지 않으므로 제출 자체가 불가능하다 — 파일 값 불변이 구조적으로 보장.
templ schemaReadOnlyRow(name, value string) {
	<div class="field field--readonly">
		<span class="field__label"><code class="field__key">{ name }</code><span class="field__ro" data-i18n="ro.note">read-only (runtime-managed)</span></span>
		<span class="input input--ro">{ value }</span>
	</div>
}

// schemaRawBlock — form UI에 맞지 않는 map/list 서브블록의 collapsed raw view
// (REQ-WC11-062). input 컨트롤 0 — <pre> 텍스트 표시만.
templ schemaRawBlock(name, content string) {
	<details class="rawview">
		<summary><code class="field__key">{ name }</code> <span data-i18n="raw.note">structured block (read-only)</span></summary>
		<pre class="rawview__pre">{ content }</pre>
	</details>
}
