diff --git a/internal/hook/session_start_lang.go b/internal/hook/session_start_lang.go
--- /dev/null
+++ b/internal/hook/session_start_lang.go
@@ -0,0 +1,25 @@
+package hook
+
+// session_start_lang.go holds the two locale helpers the factory notices, the
+// stale-run notice, and the SessionStart handler share. They moved here verbatim
+// from session_start_kanban_i18n.go (SPEC-LAUNCHER-ENTRY-FLAGS-001 M5b first step)
+// so the kanban notice files can be deleted without taking them along.
+
+// langEnglish is the fallback locale and the language of every agent-facing
+// copy. A locale absent from a locale table resolves here rather than yielding
+// an empty notice.
+const langEnglish = "en"
+
+// operatorLang reports the locale the operator reads, or langEnglish when the
+// configuration is unavailable. Fail-open: a nil provider, a nil config, or an
+// empty conversation_language degrades to English.
+func operatorLang(cfg ConfigProvider) string {
+	if cfg == nil {
+		return langEnglish
+	}
+	c := cfg.Get()
+	if c == nil || c.Language.ConversationLanguage == "" {
+		return langEnglish
+	}
+	return c.Language.ConversationLanguage
+}
