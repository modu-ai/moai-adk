diff --git a/internal/cli/launcher_retired_entries.go b/internal/cli/launcher_retired_entries.go
--- /dev/null
+++ b/internal/cli/launcher_retired_entries.go
@@ -0,0 +1,28 @@
+package cli
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Compile-probe model of the M5a file (SPEC-LAUNCHER-ENTRY-FLAGS-001): the retired -k
+// spellings live here, so the two token constants and the refusal text leave kanban.go.
+const (
+	retiredLongFlag  = "--kanban"
+	retiredShortFlag = "-k"
+)
+
+const retiredEntryRefusal = "-k/--kanban is retired: Kanban Mode was removed; use -f for the factory leader and -l for a lane"
+
+// refuseRetiredEntry returns the refusal when args carry a retired -k spelling.
+func refuseRetiredEntry(args []string) error {
+	for _, a := range args {
+		if a == "--" {
+			return nil
+		}
+		if a == retiredShortFlag || a == retiredLongFlag || strings.HasPrefix(a, retiredShortFlag+"=") || strings.HasPrefix(a, retiredLongFlag+"=") {
+			return fmt.Errorf("%s", retiredEntryRefusal)
+		}
+	}
+	return nil
+}
