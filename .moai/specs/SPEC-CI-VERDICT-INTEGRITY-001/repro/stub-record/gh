#!/bin/sh
# t1546 recording gh stub (P2-L full + P2-P + P2-O rendezvous) — duties:
#   1. ON FIRST CONTACT (any subcommand): advance the served clock file from
#      MOCK_CLOCK_START to MOCK_CLOCK_ADVANCED — the "time passes between the
#      check and the merge" event (P2-O). Idempotent: a CROSSED marker line
#      means already advanced; served time is always the file's FIRST line.
#   2. RECORD every invocation (query or merge) with its SERVED time (the
#      clock file's first line at call time) and a late flag, to
#      $MOCK_CALL_LOG — observational only; the PROBE judges.
#   3. ANSWER the AC-CI-003 head re-query: `gh pr view <N> --json headRefOid`
#      returns the FIXTURE SHA (a documented probe constant, not a real
#      commit) so a legitimate M1 head re-check can pass.
#   4. FAIL DISTINCTLY: a log append failure emits
#      `t1546-stub-log-write-failed` on stderr and exits 64 — the probe maps
#      it to harness failure (exit 4), never to an observed merge decision.
MOCK_CALL_LOG="${MOCK_CALL_LOG:?MOCK_CALL_LOG not set}"
MOAI_CLOCK_FILE="${MOAI_CLOCK_FILE:?MOAI_CLOCK_FILE not set}"
MOCK_CLOCK_START="${MOCK_CLOCK_START:-1100}"
MOCK_CLOCK_ADVANCED="${MOCK_CLOCK_ADVANCED:-1200}"
FIXTURE_SHA="a158b4b5f0000000000000000000000000000000"

if ! grep -q '^CROSSED$' "$MOAI_CLOCK_FILE" 2>/dev/null; then
  printf '%s\nCROSSED\n' "$MOCK_CLOCK_ADVANCED" > "$MOAI_CLOCK_FILE" 2>/dev/null || true
fi
served="$(sed -n 1p "$MOAI_CLOCK_FILE" 2>/dev/null || true)"
[ -n "$served" ] || served="$MOCK_CLOCK_ADVANCED"
late="no"
case "$served" in
  ''|*[!0-9]*) ;;
  *) if [ "$served" -gt "${merge_deadline:-0}" ] 2>/dev/null; then late="yes"; fi ;;
esac

if ! printf 'gh %s | served=%s late=%s\n' "$*" "$served" "$late" >> "$MOCK_CALL_LOG"; then
  echo "t1546-stub-log-write-failed: could not append to $MOCK_CALL_LOG" >&2
  exit 64
fi

case "$1 $2" in
  "pr view"*)
    printf '{"headRefOid":"%s"}\n' "$FIXTURE_SHA"
    ;;
esac
exit 0
