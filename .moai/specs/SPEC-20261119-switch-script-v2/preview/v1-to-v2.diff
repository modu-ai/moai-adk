--- moai.v1	2026-11-15 18:33:10
+++ moai.v2	2026-11-19 15:19:25
@@ -7,6 +7,11 @@
 # running Claude Code sessions call. Without this routing the Rust binary would answer
 # `moai hook ...` with exit 2, which Claude Code treats as "block this tool call".
 #
+#
+# v2 PREVIEW (SPEC-20261119-switch-script-v2, C-33 S2a): not installed. Differs from v1 in three
+# words only: `statusline` and `session` go to Rust, and `spec` goes to Rust except for the actions
+# only the Go build has. Applying it to the real HOME is a separate step the user picks (S4).
+#
 # Undo: mv "$HOME/go/bin/moai.old" "$HOME/go/bin/moai"  (and remove ~/.moai-cli/path/moai)
 RUST="${MOAI_RUST_BIN:-$HOME/.moai-cli/path/moai-cli}"
 GO="${MOAI_GO_BIN:-$HOME/go/bin/moai.old}"
@@ -15,8 +20,21 @@
   # Launcher words always go to Rust.
   cc|glm|codex|omp|-l|-a|--leader|--agent)
     exec "$RUST" "$@" ;;
+  # v2 (preview, C-33 S2a): `statusline` and `session` are no longer listed below, so they reach
+  # Rust. `spec` is split by action: the actions only the Go build has stay with Go (Go-generation
+  # projects still call `moai spec lint` and `moai spec audit`), every other `spec` call is Rust's.
+  spec)
+    case "${2:-}" in
+      status|drift|view|lint|audit|archive|ceiling) ;;
+      *) exec "$RUST" "$@" ;;
+    esac
+    if [ -x "$GO" ]; then
+      exec "$GO" "$@"
+    fi
+    echo "moai: '$1' belongs to the Go build, which was not found at $GO" >&2
+    exit 1 ;;
   # Subcommands only the Go build has.
-  af|agent|ast-edit|ast-grep|bundle|chain|ci-verdict|clean|completion|config|constitution|contract|decision|doctor|epic|factory|feedback|fetch|gate|github|goal|graph|gtd|handoff|harness|hook|inbox|init|integration|inventory|jev|jevmeasure|loop|lsp|mcp|mcp-server|memory|migrate|migration|moai|mx|paths|plan|pr|preference|profile|research|session|slot|spec|state|status|statusline|telemetry|that|todo|tokens|tool-policy|verify|version|web|workflow|worktree)
+  af|agent|ast-edit|ast-grep|bundle|chain|ci-verdict|clean|completion|config|constitution|contract|decision|doctor|epic|factory|feedback|fetch|gate|github|goal|graph|gtd|handoff|harness|hook|inbox|init|integration|inventory|jev|jevmeasure|loop|lsp|mcp|mcp-server|memory|migrate|migration|moai|mx|paths|plan|pr|preference|profile|research|slot|state|status|telemetry|that|todo|tokens|tool-policy|verify|version|web|workflow|worktree)
     # #3021: a long-lived MCP server must keep its own audit jobs; with the shim on PATH it always
     # reads as stale and would hand writes to a one-shot process that loses them.
     case "$1" in mcp-server) export MOAI_MCP_ONESHOT=1 ;; esac
