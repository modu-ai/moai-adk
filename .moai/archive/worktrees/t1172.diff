+func codexAuditProjectConfig(t *testing.T, root, wrapper string) string {
+	t.Helper()
+	workflow := filepath.Join(root, ".moai", "config", "sections", "workflow.yaml")
+	if err := os.MkdirAll(filepath.Dir(workflow), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(workflow, []byte("workflow:\n  codex:\n    preapproval:\n      enabled: true\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	var out, warn bytes.Buffer
+	if _, err := codexwiring.Wire(root, &out, &warn); err != nil {
+		t.Fatalf("codex wiring: %v: %s", err, warn.String())
+	}
+	path := filepath.Join(root, ".codex", "config.toml")
+	body, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config := strings.Replace(string(body), `command = "moai"`, "command = "+fmt.Sprintf("%q", wrapper), 1)
+	if config == string(body) || strings.Count(config, "[mcp_servers.moai.tools.codex_role_audit]") != 1 {
+		t.Fatalf("writer did not emit one pre-approved moai tool: %s", config)
+	}
+	config = "sandbox_mode = \"workspace-write\"\n" + config
+	if err := os.WriteFile(path, []byte(config), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return config
+}
