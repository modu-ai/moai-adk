+func preApprovalCar010PrepAttempt(rows []map[string]any) (int, error) {
+	starts := 0
+	for _, row := range rows {
+		if row["kind"] == "stop" || row["kind"] == "invalidate" && row["fixture"] == "car010" ||
+			row["kind"] == "live" && row["fixture"] == "car010" {
+			return 0, errors.New("car010 evidence already stopped or attempted")
+		}
+		if row["kind"] == "startup" && row["fixture"] == "car010" {
+			starts++
+		}
+	}
+	if starts != 2 {
+		return 0, fmt.Errorf("car010 requires M1-a and M1-b startups, got %d", starts)
+	}
+	return 1, nil
+}
