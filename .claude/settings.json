{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-session-start.sh\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-compact.sh\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-session-end.sh\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-pre-tool.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-post-tool.sh\"",
            "timeout": 10,
            "type": "command",
            "async": true
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/status-transition-ownership.sh\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-security-scan.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-harness-observe.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-stop.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/sync-phase-quality-gate.sh\"",
            "timeout": 60,
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-stop-goal.sh\"",
            "timeout": 120,
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-security-turn.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-security-commit.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-harness-observe-stop.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-subagent-stop.sh\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-harness-observe-subagent-stop.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-post-tool-failure.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-subagent-start.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-user-prompt-submit.sh\"",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-harness-observe-user-prompt-submit.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-teammate-idle.sh\"",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-task-completed.sh\"",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "project_settings|local_settings|skills",
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-config-change.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|authentication_failed|billing_error|max_output_tokens",
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-stop-failure.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-post-compact.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-instructions-loaded.sh\"",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-cwd-changed.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-file-changed.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ".env|.envrc|.gitignore"
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-permission-denied.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/moai/handle-permission-request.sh\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.moai/status_line.sh",
    "refreshInterval": 10
  },
  "skillListingBudgetFraction": 0.02,
  "showThinkingSummaries": false,
  "cleanupPeriodDays": 30,
  "outputStyle": "MoAI-Easy",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "MOAI_CONFIG_SOURCE": "sections"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Agent",
          "AskUserQuestion",
          "Bash(ast-grep:*)",
          "Bash(awk:*)",
          "Bash(basename:*)",
          "Bash(black:*)",
          "Bash(bun*)",
          "Bash(cat:*)",
          "Bash(comm:*)",
          "Bash(coverage:*)",
          "Bash(cp:*)",
          "Bash(curl:*)",
          "Bash(cut:*)",
          "Bash(diff:*)",
          "Bash(dirname:*)",
          "Bash(echo:*)",
          "Bash(eslint:*)",
          "Bash(false:*)",
          "Bash(find:*)",
          "Bash(flake8:*)",
          "Bash(gh issue:*)",
          "Bash(gh pr:*)",
          "Bash(gh repo view:*)",
          "Bash(git add:*)",
          "Bash(git blame:*)",
          "Bash(git branch:*)",
          "Bash(git checkout:*)",
          "Bash(git commit:*)",
          "Bash(git config:*)",
          "Bash(git diff:*)",
          "Bash(git fetch:*)",
          "Bash(git log:*)",
          "Bash(git merge:*)",
          "Bash(git pull:*)",
          "Bash(git push:*)",
          "Bash(git remote:*)",
          "Bash(git revert:*)",
          "Bash(git show:*)",
          "Bash(git stash:*)",
          "Bash(git status:*)",
          "Bash(git switch:*)",
          "Bash(git tag:*)",
          "Bash(grep:*)",
          "Bash(head:*)",
          "Bash(jq:*)",
          "Bash(less:*)",
          "Bash(ls:*)",
          "Bash(lsof:*)",
          "Bash(make:*)",
          "Bash(man:*)",
          "Bash(mkdir:*)",
          "Bash(moai-adk:*)",
          "Bash(moai:*)",
          "Bash(mv:*)",
          "Bash(mypy:*)",
          "Bash(node*)",
          "Bash(npm*)",
          "Bash(npx*)",
          "Bash(pip*)",
          "Bash(pip3:*)",
          "Bash(pnpm*)",
          "Bash(prettier:*)",
          "Bash(printf:*)",
          "Bash(pwd:*)",
          "Bash(pydoc:*)",
          "Bash(pylint:*)",
          "Bash(pytest:*)",
          "Bash(python3:*)",
          "Bash(python:*)",
          "Bash(readlink:*)",
          "Bash(realpath:*)",
          "Bash(rg:*)",
          "Bash(rsync:*)",
          "Bash(ruff:*)",
          "Bash(sed:*)",
          "Bash(sg:*)",
          "Bash(sort:*)",
          "Bash(tail:*)",
          "Bash(test:*)",
          "Bash(time:*)",
          "Bash(touch:*)",
          "Bash(tree:*)",
          "Bash(true:*)",
          "Bash(type:*)",
          "Bash(uniq:*)",
          "Bash(uv*)",
          "Bash(wc:*)",
          "Bash(which:*)",
          "Bash(xargs:*)",
          "Bash(yarn*)",
          "Bash(yq:*)",
          "BashOutput",
          "Edit",
          "Glob",
          "Grep",
          "KillShell",
          "MultiEdit",
          "NotebookEdit",
          "Read",
          "Skill",
          "TaskCreate",
          "TaskGet",
          "TaskList",
          "TaskUpdate",
          "TodoWrite",
          "WebFetch",
          "WebSearch",
          "Write"
    ],
    "ask": [
      "Bash(ansible-playbook:*)",
          "Bash(chmod:*)",
          "Bash(chown:*)",
          "Bash(helm upgrade:*)",
          "Bash(kubectl apply:*)",
          "Bash(rm:*)",
          "Bash(sudo:*)"
    ],
    "deny": [
      "Bash(Clear-Disk:*)",
          "Bash(DELETE FROM:*)",
          "Bash(DROP DATABASE:*)",
          "Bash(DROP TABLE:*)",
          "Bash(Format-Volume:*)",
          "Bash(Remove-Item -Recurse -Force C\\:/:*)",
          "Bash(TRUNCATE:*)",
          "Bash(aws iam attach-*:*)",
          "Bash(aws iam create-*:*)",
          "Bash(aws iam put-*:*)",
          "Bash(chmod -R 777:*)",
          "Bash(chmod 777:*)",
          "Bash(dd:*)",
          "Bash(del /S /Q C\\:/:*)",
          "Bash(fdisk:*)",
          "Bash(format:*)",
          "Bash(gcloud * add-iam-policy-binding:*)",
          "Bash(git clean -fd:*)",
          "Bash(git clean -fdx:*)",
          "Bash(git push --force-with-lease:*)",
          "Bash(git push --force:*)",
          "Bash(git push -f:*)",
          "Bash(git push origin main:*)",
          "Bash(git push origin master:*)",
          "Bash(git rebase -i:*)",
          "Bash(git reset --hard:*)",
          "Bash(init:*)",
          "Bash(kill -9:*)",
          "Bash(killall:*)",
          "Bash(mkfs:*)",
          "Bash(mongo:*)",
          "Bash(mongosh:*)",
          "Bash(mysql -e DROP:*)",
          "Bash(psql -c DROP:*)",
          "Bash(reboot:*)",
          "Bash(redis-cli FLUSHALL:*)",
          "Bash(redis-cli FLUSHDB:*)",
          "Bash(rm -rf /*:*)",
          "Bash(rm -rf /:*)",
          "Bash(rm -rf C\\:/*:*)",
          "Bash(rm -rf C\\:/:*)",
          "Bash(rm -rf ~/*:*)",
          "Bash(rm -rf ~:*)",
          "Bash(rmdir /S /Q C\\:/:*)",
          "Bash(shutdown:*)",
          "Bash(systemctl:*)",
          "Bash(terraform destroy:*)",
          "Edit(./secrets/**)",
          "Edit(~/.aws/**)",
          "Edit(~/.config/gcloud/**)",
          "Edit(~/.ssh/**)",
          "Read(./.env)",
          "Read(./.env.*)",
          "Read(./secrets/**)",
          "Read(~/.aws/**)",
          "Read(~/.config/gcloud/**)",
          "Read(~/.ssh/**)"
    ]
  },
  "attribution": {
    "commit": "🗿 MoAI",
    "pr": "🗿 MoAI",
    "sessionUrl": false
  },
  "respectGitignore": true
}
