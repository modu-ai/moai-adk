#!/bin/sh
# MoAI commit-msg hook: refuse card numbers in the commit message — the same scan
# `moai trailer-check --card-numbers-since` runs on a range, judging the draft
# message git hands this hook (SPEC-20261120-commit-message-card-numbers).
# Install: a hand install copies or links this file into .git/hooks/ (or your
# core.hooksPath folder) as commit-msg and makes it executable. This hook is not part of
# the managed git-hook set: the card-number scan belongs to the repositories that own the
# rule, so the git-hook feature never installs this file itself.
# When `moai` is not on PATH the hook lets the commit through and says so.
if ! command -v moai >/dev/null 2>&1; then
    printf '[commit-msg] moai not on PATH -- message not checked\n' >&2
    exit 0
fi
exec moai trailer-check --message-file "$1"
