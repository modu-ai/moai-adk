#!/bin/sh
# MoAI pre-push hook (Rust): the commit-message convention scan (`moai trailer-check`) on the
# pushed range — the commits the remote does not have yet. Installed by the MoAI git-hook
# feature (`moai update --confirm-git-hooks <token>`).
# Git feeds this hook one "<local-ref> <local-sha> <remote-ref> <remote-sha>" line per pushed
# ref on stdin; any failing line fails the push. A new remote branch has no pushed range, so
# it passes with a note. When `moai` is not on PATH the hook lets the push through and says so.
if ! command -v moai >/dev/null 2>&1; then
    printf '[pre-push] moai not on PATH -- pushed commits not checked\n' >&2
    exit 0
fi
ZERO=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        printf '[pre-push] new branch %s -- no remote range to check\n' "$local_ref" >&2
        continue
    fi
    if ! moai trailer-check "$remote_sha..$local_sha" --card-numbers-since "$remote_sha"; then
        fail=1
    fi
done
exit "$fail"
