#!/bin/sh
# MoAI pre-push hook (Rust): the commit-message convention scan (`moai trailer-check`) on the
# pushed range, with the card-number scan for everything the remote does not have yet. Installed
# by the MoAI git-hook feature (`moai update --confirm-git-hooks <token>`).
# Git feeds this hook one "<local-ref> <local-sha> <remote-ref> <remote-sha>" line per pushed
# ref on stdin; any failing line fails the push. When `moai` is not on PATH the hook lets the
# push through and says so.
if ! command -v moai >/dev/null 2>&1; then
    printf '[pre-push] moai not on PATH -- pushed commits not checked\n' >&2
    exit 0
fi
ZERO=0000000000000000000000000000000000000000
fail=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    if [ "$local_sha" = "$ZERO" ]; then
        continue
    fi
    if [ "$remote_sha" = "$ZERO" ]; then
        base=$(git rev-list --max-parents=0 --max-count=1 "$local_sha" 2>/dev/null)
        if [ -z "$base" ] || [ "$base" = "$local_sha" ]; then
            continue
        fi
        range="$base..$local_sha"
        since="$base"
    else
        range="$remote_sha..$local_sha"
        since="$remote_sha"
    fi
    if ! moai trailer-check "$range" --card-numbers-since "$since"; then
        fail=1
    fi
done
exit "$fail"
