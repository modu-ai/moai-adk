{
  "description": "MoAI receipt hooks (generated by moai-cli hooks-apply; edits make the next plan stop for review)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "moai-cli hook-dispatch --host codex --event session-check",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "moai-cli claim-verify . --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "moai-cli hook-receipt --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
