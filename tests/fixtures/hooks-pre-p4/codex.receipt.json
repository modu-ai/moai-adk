{
  "schema_version": 1,
  "hooks_path": ".codex/hooks.json",
  "sha256": "sha256:7539fda0dbab97970be03160c4c5f00ab7fcb0b406e5bad6fb6397fb5b9ebc8a",
  "hooks": [
    {
      "event": "SessionStart",
      "matcher": null,
      "command": "moai-cli hook-dispatch --host codex --event session-check",
      "timeout": 10
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "command": "moai-cli claim-verify . --hook",
      "timeout": 10
    },
    {
      "event": "PostToolUse",
      "matcher": "Bash",
      "command": "moai-cli hook-receipt --host codex",
      "timeout": 10
    }
  ]
}
